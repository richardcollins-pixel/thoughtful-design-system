{
  "name": "Feedback sheet",
  "tier": "patterns",
  "category": "sheets",
  "stateful": false,
  "uses": [
    "organisms/bottom-sheet",
    "atoms/button",
    "atoms/textarea",
    "molecules/rating-option",
    "molecules/toast",
    "device/keyboard"
  ],
  "figma": "https://www.figma.com/design/qGPykdv2u1DdzaycmLLaK0/In-App-Feedback?node-id=969-12616",
  "states": [
    {
      "id": "rating",
      "name": "Rating",
      "template": "<div class=\"bottom-sheet feedback-sheet\" data-selected=\"no\" data-animate=\"on\"><span class=\"bottom-sheet__handle\"></span><div class=\"bottom-sheet__header feedback-sheet__head\" data-slot=\"header\">{{item:title}}{{item:intro}}</div><div class=\"bottom-sheet__content\" data-slot=\"content\"><div class=\"feedback-sheet__ratings\">{{item:r1}}{{item:r2}}{{item:r3}}</div></div><div class=\"bottom-sheet__action\" data-slot=\"action\">{{item:next}}</div></div>",
      "slots": [
        {
          "id": "header",
          "label": "Header slot",
          "items": [
            "title",
            "intro"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "r1",
            "r2",
            "r3"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "next"
          ]
        }
      ],
      "personas": []
    },
    {
      "id": "rating-picked",
      "name": "Rating picked",
      "template": "<div class=\"bottom-sheet feedback-sheet\" data-selected=\"yes\" data-animate=\"off\"><span class=\"bottom-sheet__handle\"></span><div class=\"bottom-sheet__header feedback-sheet__head\" data-slot=\"header\">{{item:title}}{{item:intro}}</div><div class=\"bottom-sheet__content\" data-slot=\"content\"><div class=\"feedback-sheet__ratings\">{{item:r1}}{{item:r2}}{{item:r3}}</div></div><div class=\"bottom-sheet__action\" data-slot=\"action\">{{item:next}}</div></div>",
      "slots": [
        {
          "id": "header",
          "label": "Header slot",
          "items": [
            "title",
            "intro"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "r1",
            "r2",
            "r3"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "next"
          ]
        }
      ],
      "personas": [],
      "overrides": {
        "r1": {
          "props": {
            "selected": "dim"
          }
        },
        "r2": {
          "props": {
            "selected": "dim"
          }
        },
        "r3": {
          "props": {
            "selected": "yes"
          }
        }
      }
    },
    {
      "id": "comment",
      "name": "Comment",
      "template": "<div class=\"bottom-sheet feedback-sheet\" data-compact data-selected=\"yes\" data-animate=\"off\"><span class=\"bottom-sheet__handle\"></span><div class=\"bottom-sheet__header feedback-sheet__head\" data-slot=\"header\">{{item:question}}</div><div class=\"bottom-sheet__content\" data-slot=\"content\">{{item:field}}</div><div class=\"bottom-sheet__action\" data-slot=\"action\">{{item:submit}}</div></div>",
      "slots": [
        {
          "id": "header",
          "label": "Header slot",
          "items": [
            "question"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "field"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "submit"
          ]
        }
      ],
      "personas": []
    },
    {
      "id": "comment-typing",
      "name": "Comment, typing",
      "template": "<div class=\"bottom-sheet feedback-sheet\" data-compact data-selected=\"yes\" data-animate=\"off\"><span class=\"bottom-sheet__handle\"></span><div class=\"bottom-sheet__header feedback-sheet__head\" data-slot=\"header\">{{item:question}}</div><div class=\"bottom-sheet__content\" data-slot=\"content\">{{item:field}}</div><div class=\"bottom-sheet__action\" data-slot=\"action\">{{item:submit}}</div><div class=\"bottom-sheet__keyboard\" data-slot=\"keyboard\">{{item:keyboard}}</div></div>",
      "slots": [
        {
          "id": "header",
          "label": "Header slot",
          "items": [
            "question"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "field"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "submit"
          ]
        },
        {
          "id": "keyboard",
          "label": "Keyboard slot",
          "items": [
            "keyboard"
          ]
        }
      ],
      "personas": [],
      "overrides": {
        "field": {
          "props": {
            "text": "This is what the user typed",
            "filled": "yes"
          }
        }
      }
    },
    {
      "id": "sent",
      "name": "Sent",
      "template": "<div class=\"feedback-sheet\" data-sent><div class=\"feedback-sheet__toast\" data-slot=\"toast\">{{item:toast}}</div></div>",
      "slots": [
        {
          "id": "toast",
          "label": "Toast slot",
          "items": [
            "toast"
          ]
        }
      ],
      "personas": []
    }
  ],
  "variables": {},
  "styles": [],
  "selector": ".feedback-sheet",
  "align": "bottom",
  "description": "The in-app feedback bottom sheet (the bottom sheet organism's slots), which can pop up anywhere. Rating: the header asks how you like Thoughtful, the content is three faces that rise in one after another (the animation), the action is Continue (dimmed until you pick). Rating picked dims the other two. Comment asks for one sentence in a text area with Submit, with the keyboard up while typing. Sent is the thank-you toast.",
  "items": {
    "title": {
      "type": "text",
      "tag": "h2",
      "class": "bottom-sheet__title",
      "label": "Headline",
      "value": "How are you liking thoughtful?"
    },
    "intro": {
      "type": "text",
      "tag": "p",
      "class": "bottom-sheet__intro",
      "label": "Intro",
      "value": "We’d love your feedback to help us improve the experience."
    },
    "r1": {
      "type": "component",
      "component": "molecules/rating-option",
      "label": "Rating 1",
      "props": {
        "face": "set-boundaries",
        "tilt": "left",
        "label": "Not Satisfied",
        "selected": "no",
        "order": "0"
      },
      "expose": [
        "label",
        "selected"
      ]
    },
    "r2": {
      "type": "component",
      "component": "molecules/rating-option",
      "label": "Rating 2",
      "props": {
        "face": "give-yourself-grace",
        "tilt": "none",
        "label": "Satisfied",
        "selected": "no",
        "order": "1"
      },
      "expose": [
        "label",
        "selected"
      ]
    },
    "r3": {
      "type": "component",
      "component": "molecules/rating-option",
      "label": "Rating 3",
      "props": {
        "face": "build-connections",
        "tilt": "right",
        "label": "Very Satisfied",
        "selected": "no",
        "order": "2"
      },
      "expose": [
        "label",
        "selected"
      ]
    },
    "next": {
      "type": "component",
      "component": "atoms/button",
      "label": "Continue",
      "props": {
        "label": "Continue",
        "variant": "filled",
        "size": "md",
        "width": "full"
      },
      "expose": [
        "label"
      ]
    },
    "question": {
      "type": "text",
      "tag": "p",
      "class": "feedback-sheet__question",
      "label": "Question",
      "value": "In one sentence, how was Thoughtful different from other mental health or wellbeing resources you’ve used (at work or elsewhere)?"
    },
    "field": {
      "type": "component",
      "component": "atoms/textarea",
      "label": "Field",
      "props": {
        "text": "Share your feedback",
        "filled": "no"
      },
      "expose": [
        "text",
        "filled"
      ]
    },
    "submit": {
      "type": "component",
      "component": "atoms/button",
      "label": "Submit",
      "props": {
        "label": "Submit Feedback",
        "variant": "filled",
        "size": "md",
        "width": "full"
      },
      "expose": [
        "label"
      ]
    },
    "keyboard": {
      "type": "component",
      "component": "device/keyboard",
      "label": "Keyboard",
      "props": {},
      "expose": []
    },
    "toast": {
      "type": "component",
      "component": "molecules/toast",
      "label": "Toast",
      "props": {
        "status": "success",
        "title": "Thanks for the feedback!",
        "body": "We will use it to make Thoughtful better for you and others."
      },
      "expose": [
        "title",
        "body"
      ]
    }
  },
  "personas": [],
  "properties": [],
  "prompts": []
}