    "heading": {
      "type": "text",
      "tag": "h2",
      "class": "therapist-section__title",
      "label": "Subhead",
      "value": "Your Therapist",
      "skeleton": {
        "lines": 1
      }
    },
    "copy": {
      "type": "text",
      "tag": "p",
      "class": "therapist-section__copy",
      "label": "Copy",
      "value": "Get support and accountability",
      "skeleton": {
        "lines": 1
      }
    },
    "card": {
      "type": "component",
      "component": "organisms/appointment-card",
      "label": "Therapist card",
      "props": {
        "state": "provider-cta"
      },
      "expose": [
        "state",
        "headline",
        "body"
      ]
    }
  },
  "personas": [
