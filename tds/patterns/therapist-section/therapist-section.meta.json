      "id": "find",
      "name": "Find a therapist",
      "template": "<section class=\"therapist-section\"><div class=\"therapist-section__header\" data-slot=\"header\">{{item:heading}}{{item:copy}}</div><div class=\"therapist-section__card\" data-slot=\"card\">{{item:card}}</div></section>",
      "slots": [
        {
          "id": "header",
          "label": "Header slot",
          "items": [
            "heading",
            "copy"
          ],
          "skeleton": true
        },
        {
          "id": "card",
          "label": "Card slot",
          "items": [
            "card"
          ],
          "skeleton": true
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {
