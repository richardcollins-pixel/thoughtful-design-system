{
  "name": "Session sharing sheet",
  "tier": "patterns",
  "category": "sheets",
  "stateful": false,
  "uses": [
    "organisms/bottom-sheet",
    "atoms/button",
    "molecules/toggle-row",
    "molecules/avatar-text"
  ],
  "figma": "https://www.figma.com/design/2dd93uRGMkAzwfaUu9CcSi/Session-Sharing?node-id=629-3943",
  "states": [
    {
      "id": "off",
      "name": "Sharing",
      "template": "<div class=\"bottom-sheet session-sharing\"><span class=\"bottom-sheet__handle\"></span><div class=\"bottom-sheet__header session-sharing__header\" data-slot=\"header\">{{item:title}}{{item:body}}<ul class=\"session-sharing__list\">{{item:b1}}{{item:b2}}{{item:b3}}</ul></div><div class=\"bottom-sheet__content session-sharing__group\" data-slot=\"content\">{{item:toggle}}<hr class=\"session-sharing__rule\"><div class=\"session-sharing__safety\"><i class=\"icon icon-help\"></i>{{item:safety}}</div></div><div class=\"bottom-sheet__action\" data-slot=\"action\">{{item:done}}</div></div>",
      "slots": [
        {
          "id": "header",
          "label": "Header slot",
          "items": [
            "title",
            "body",
            "b1",
            "b2",
            "b3"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "toggle",
            "safety"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "done"
          ]
        }
      ],
      "personas": [
        "provider"
      ]
    },
    {
      "id": "off-record",
      "name": "Off the record",
      "template": "<div class=\"bottom-sheet session-sharing\"><span class=\"bottom-sheet__handle\"></span><div class=\"bottom-sheet__header session-sharing__header\" data-slot=\"header\">{{item:title}}{{item:body}}<ul class=\"session-sharing__list\">{{item:b1}}{{item:b2}}{{item:b3}}</ul></div><div class=\"bottom-sheet__content session-sharing__group\" data-slot=\"content\">{{item:toggle}}<hr class=\"session-sharing__rule\"><div class=\"session-sharing__safety\"><i class=\"icon icon-help\"></i>{{item:safety}}</div></div><div class=\"bottom-sheet__action\" data-slot=\"action\">{{item:done}}</div></div>",
      "slots": [
        {
          "id": "header",
          "label": "Header slot",
          "items": [
            "title",
            "body",
            "b1",
            "b2",
            "b3"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "toggle",
            "safety"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "done"
          ]
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {
        "toggle": {
          "props": {
            "on": "true"
          }
        }
      }
    }
  ],
  "variables": {},
  "styles": [],
  "selector": ".session-sharing",
  "description": "A bottom sheet (the bottom sheet organism's slots) for the record icon in a chat. Header: T and your provider, a serif headline, copy and three bullets. Content: the go off the record toggle and the safety note. Action: Done. Sharing has the toggle off; Off the record has it on.",
  "items": {
    "body": {
      "type": "text",
      "tag": "p",
      "class": "session-sharing__body",
      "label": "Body Copy",
      "value": "They get a short recap of what you covered so you can spend your appointment going deeper, not catching up."
    },
    "b1": {
      "type": "text",
      "tag": "li",
      "class": "session-sharing__bullet",
      "label": "Bullet 1",
      "value": "We’re all on the same page"
    },
    "b2": {
      "type": "text",
      "tag": "li",
      "class": "session-sharing__bullet",
      "label": "Bullet 2",
      "value": "Nothing gets lost between appointments"
    },
    "b3": {
      "type": "text",
      "tag": "li",
      "class": "session-sharing__bullet",
      "label": "Bullet 3",
      "value": "Build on discoveries we make together"
    },
    "toggle": {
      "type": "component",
      "component": "molecules/toggle-row",
      "label": "Toggle row",
      "props": {
        "title": "Go off the record",
        "sub": "Keep this between you and T",
        "on": "false"
      },
      "expose": [
        "title",
        "sub",
        "on"
      ]
    },
    "safety": {
      "type": "text",
      "tag": "p",
      "class": "session-sharing__safety-text",
      "label": "Safety note",
      "value": "Our care team will be notified if any conversation raises a safety concern"
    },
    "done": {
      "type": "component",
      "component": "atoms/button",
      "label": "Button",
      "props": {
        "label": "Done",
        "variant": "filled",
        "size": "md",
        "width": "full"
      },
      "expose": [
        "label"
      ]
    },
    "title": {
      "type": "component",
      "component": "molecules/avatar-text",
      "label": "Title",
      "props": {
        "avatar": "t-provider",
        "size": "32",
        "style": "subhead",
        "title": "Your support is better when {{provider-name}} is up to speed"
      },
      "bind": {
        "person": "provider"
      },
      "expose": [
        "title",
        "avatar",
        "person"
      ]
    }
  },
  "personas": [
    "provider"
  ],
  "properties": [],
  "prompts": [],
  "align": "bottom"
}