{
  "name": "Chat header",
  "tier": "molecules",
  "category": "navigation",
  "stateful": false,
  "uses": [
    "atoms/status-bar",
    "atoms/blob",
    "atoms/icon-button"
  ],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=4446-19046",
  "attributes": {
    "data-timer": {
      "type": "enum",
      "values": [
        "off",
        "on"
      ],
      "default": "off"
    },
    "data-recap": {
      "type": "enum",
      "values": [
        "off",
        "on"
      ],
      "default": "off"
    }
  },
  "states": [],
  "variables": {},
  "styles": [],
  "description": "The top of a chat: the status bar, then T and the name of the session. With the timer on, a thin progress bar under the name shows how far through the session you are and the icons are at full strength; off, they are quiet. An optional icon says your therapist can see a recap of the conversation, and the check finishes the session.",
  "content": [
    {
      "label": "Title",
      "selector": ".chat-header__title"
    }
  ],
  "props": {
    "title": {
      "type": "text",
      "label": "Title",
      "default": "Leave it here"
    },
    "timer": {
      "type": "enum",
      "label": "Timer",
      "values": [
        "off",
        "on"
      ],
      "default": "off",
      "ui": "steps"
    },
    "progress": {
      "type": "text",
      "label": "Progress (%)",
      "default": "10"
    },
    "recap": {
      "type": "enum",
      "label": "Therapist recap",
      "values": [
        "off",
        "on"
      ],
      "default": "off",
      "ui": "steps"
    },
    "time": {
      "type": "text",
      "label": "Time",
      "default": "9:41"
    }
  },
  "template": "<header class=\"chat-header\" data-timer=\"{{timer}}\" data-recap=\"{{recap}}\"><div class=\"chat-header__status\"><div class=\"status-bar\"><span>{{time}}</span><svg viewBox=\"0 0 18 12\" width=\"18\" height=\"12\" fill=\"currentColor\" aria-hidden=\"true\"><rect x=\"0\" y=\"8\" width=\"3\" height=\"4\" rx=\"1\"/><rect x=\"5\" y=\"5.5\" width=\"3\" height=\"6.5\" rx=\"1\"/><rect x=\"10\" y=\"3\" width=\"3\" height=\"9\" rx=\"1\"/><rect x=\"15\" y=\"0\" width=\"3\" height=\"12\" rx=\"1\"/></svg><svg viewBox=\"0 0 17 12\" width=\"17\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M1.2 4.2a10.4 10.4 0 0 1 14.6 0\"/><path d=\"M3.9 7a6.5 6.5 0 0 1 9.2 0\"/><circle cx=\"8.5\" cy=\"10.2\" r=\"1\" fill=\"currentColor\" stroke=\"none\"/></svg><svg viewBox=\"0 0 27 13\" width=\"27\" height=\"13\" fill=\"none\" aria-hidden=\"true\"><rect x=\"0.5\" y=\"0.5\" width=\"22\" height=\"12\" rx=\"3.8\" stroke=\"currentColor\" opacity=\"0.4\"/><rect x=\"2\" y=\"2\" width=\"19\" height=\"9\" rx=\"2.5\" fill=\"currentColor\"/><path d=\"M24.5 4.5v4c.9-.3 1.5-1.2 1.5-2s-.6-1.7-1.5-2Z\" fill=\"currentColor\" opacity=\"0.5\"/></svg></div></div><div class=\"chat-header__bar\"><div class=\"chat-header__left\"><div class=\"blob\" data-size=\"24\" data-theme=\"rose\"><canvas aria-hidden=\"true\"></canvas></div><div class=\"chat-header__stack\"><span class=\"chat-header__title\">{{title}}</span><span class=\"chat-header__progress\" style=\"--progress:{{progress}}%\"><i></i></span></div></div><div class=\"chat-header__right\"><button class=\"icon-button chat-header__recap\" data-elevation=\"0\" data-size=\"md\" aria-label=\"Your therapist can see a recap\"><i class=\"icon icon-person-check\"></i></button><button class=\"icon-button chat-header__done\" data-elevation=\"20\" data-size=\"sm\" aria-label=\"Finish\"><i class=\"icon icon-check\"></i></button></div></div></header>",
  "markup": "<header class=\"chat-header\" data-timer=\"off\" data-recap=\"off\"><div class=\"chat-header__status\"><div class=\"status-bar\"><span>9:41</span><svg viewBox=\"0 0 18 12\" width=\"18\" height=\"12\" fill=\"currentColor\" aria-hidden=\"true\"><rect x=\"0\" y=\"8\" width=\"3\" height=\"4\" rx=\"1\"/><rect x=\"5\" y=\"5.5\" width=\"3\" height=\"6.5\" rx=\"1\"/><rect x=\"10\" y=\"3\" width=\"3\" height=\"9\" rx=\"1\"/><rect x=\"15\" y=\"0\" width=\"3\" height=\"12\" rx=\"1\"/></svg><svg viewBox=\"0 0 17 12\" width=\"17\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M1.2 4.2a10.4 10.4 0 0 1 14.6 0\"/><path d=\"M3.9 7a6.5 6.5 0 0 1 9.2 0\"/><circle cx=\"8.5\" cy=\"10.2\" r=\"1\" fill=\"currentColor\" stroke=\"none\"/></svg><svg viewBox=\"0 0 27 13\" width=\"27\" height=\"13\" fill=\"none\" aria-hidden=\"true\"><rect x=\"0.5\" y=\"0.5\" width=\"22\" height=\"12\" rx=\"3.8\" stroke=\"currentColor\" opacity=\"0.4\"/><rect x=\"2\" y=\"2\" width=\"19\" height=\"9\" rx=\"2.5\" fill=\"currentColor\"/><path d=\"M24.5 4.5v4c.9-.3 1.5-1.2 1.5-2s-.6-1.7-1.5-2Z\" fill=\"currentColor\" opacity=\"0.5\"/></svg></div></div><div class=\"chat-header__bar\"><div class=\"chat-header__left\"><div class=\"blob\" data-size=\"24\" data-theme=\"rose\"><canvas aria-hidden=\"true\"></canvas></div><div class=\"chat-header__stack\"><span class=\"chat-header__title\">Leave it here</span><span class=\"chat-header__progress\" style=\"--progress:10%\"><i></i></span></div></div><div class=\"chat-header__right\"><button class=\"icon-button chat-header__recap\" data-elevation=\"0\" data-size=\"md\" aria-label=\"Your therapist can see a recap\"><i class=\"icon icon-person-check\"></i></button><button class=\"icon-button chat-header__done\" data-elevation=\"20\" data-size=\"sm\" aria-label=\"Finish\"><i class=\"icon icon-check\"></i></button></div></div></header>"
}