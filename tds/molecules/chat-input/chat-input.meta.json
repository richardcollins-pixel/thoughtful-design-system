{
  "name": "Chat input",
  "tier": "molecules",
  "category": "actions",
  "stateful": false,
  "uses": [
    "atoms/icon"
  ],
  "markup": "<div class=\"chat-input\" data-variant=\"pill\"><span>Start session</span><i class=\"icon icon-arrow-up\" data-size=\"md\"></i></div>",
  "attributes": {
    "data-variant": {
      "type": "enum",
      "values": [
        "pill",
        "empty",
        "large"
      ],
      "default": "pill"
    }
  },
  "states": [],
  "variables": {
    "--chat-input-fill": "fill",
    "--chat-input-border": "color",
    "--chat-input-text": "color",
    "--chat-input-height": "padding",
    "--chat-input-padding-x": "padding"
  },
  "styles": [],
  "description": "The pill at the bottom of a session card: a prompt and an arrow to send. Use it to start a session or a new topic from a card. Empty is the pill before anything is typed (the prompt at half strength). Large is the tall box on the home screen, with the prompt at the top and the arrow at the bottom right.",
  "content": [
    {
      "label": "Prompt",
      "selector": ":scope > span"
    }
  ],
  "props": {
    "text": {
      "type": "text",
      "label": "Prompt",
      "default": "Start session"
    },
    "variant": {
      "type": "enum",
      "label": "Variant",
      "values": [
        "pill",
        "empty",
        "large"
      ],
      "default": "pill"
    }
  },
  "template": "<div class=\"chat-input\" data-variant=\"{{variant}}\"><span>{{text}}</span><i class=\"icon icon-arrow-up\" data-size=\"md\"></i></div>"
}