{
  "name": "Tile",
  "tier": "molecules",
  "category": "content",
  "stateful": false,
  "uses": [
    "atoms/face",
    "atoms/icon",
    "atoms/icon-button",
    "atoms/skeleton"
  ],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=1046-39066",
  "markup": "<button class=\"tile\" type=\"button\"><span class=\"face\" data-face=\"calm-down\"><i></i></span><span class=\"tile__content\"><span class=\"tile__title\">Calm Down</span><span class=\"tile__label\"><i class=\"icon icon-clock\" data-size=\"sm\"></i><span>5 mins</span></span></span><span class=\"icon-button\" data-elevation=\"20\" data-size=\"sm\" aria-hidden=\"true\"><i class=\"icon icon-arrow-up\"></i></span></button>",
  "attributes": {},
  "states": [],
  "variables": {},
  "styles": [],
  "description": "A bite-size piece of support: a face, a title, how long it takes, and a round arrow. The whole row is one button. Used in columns on the home screen.",
  "content": [
    {
      "label": "Title",
      "selector": ".tile__title"
    }
  ],
  "props": {
    "face": {
      "type": "enum",
      "label": "Face",
      "values": [
        "calm-down",
        "balance-the-thought",
        "nourish-yourself",
        "give-yourself-grace",
        "settle-for-sleep",
        "reflect-on-today",
        "set-boundaries",
        "get-motivated",
        "build-connections",
        "start-a-plan"
      ],
      "default": "calm-down"
    },
    "title": {
      "type": "text",
      "label": "Title",
      "default": "Calm Down"
    },
    "duration": {
      "type": "text",
      "label": "Duration",
      "default": "5 mins"
    }
  },
  "template": "<button class=\"tile\" type=\"button\"><span class=\"face\" data-face=\"{{face}}\"><i></i></span><span class=\"tile__content\"><span class=\"tile__title\">{{title}}</span><span class=\"tile__label\"><i class=\"icon icon-clock\" data-size=\"sm\"></i><span>{{duration}}</span></span></span><span class=\"icon-button\" data-elevation=\"20\" data-size=\"sm\" aria-hidden=\"true\"><i class=\"icon icon-arrow-up\"></i></span></button>",
  "skeleton": "<div class=\"tile\"><span class=\"face\" data-state=\"loading\"></span><span class=\"tile__content\"><span class=\"skeleton-text\" data-lines=\"1\" style=\"--skeleton-first-width:70%\"><span class=\"skeleton\" data-shape=\"line\"></span><span class=\"skeleton\" data-shape=\"line\"></span><span class=\"skeleton\" data-shape=\"line\"></span><span class=\"skeleton\" data-shape=\"line\"></span></span><span class=\"skeleton-text\" data-lines=\"1\" style=\"--skeleton-first-width:40%\"><span class=\"skeleton\" data-shape=\"line\"></span><span class=\"skeleton\" data-shape=\"line\"></span><span class=\"skeleton\" data-shape=\"line\"></span><span class=\"skeleton\" data-shape=\"line\"></span></span></span><span class=\"icon-button\" data-state=\"loading\" data-elevation=\"20\" data-size=\"sm\"></span></div>"
}
