{
  "name": "Bottom nav",
  "tier": "molecules",
  "category": "navigation",
  "stateful": false,
  "uses": [
    "atoms/icon"
  ],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=3938-48499",
  "attributes": {
    "data-current": {
      "type": "enum",
      "values": [
        "home",
        "sessions",
        "profile"
      ],
      "default": "home"
    }
  },
  "states": [],
  "variables": {},
  "styles": [],
  "description": "The three tabs at the bottom of the app: Home, Sessions and Profile. The one you are on is full strength, the others half. Under it is the phone's home indicator, which the Device UI mode hides.",
  "content": [],
  "props": {
    "current": {
      "type": "enum",
      "label": "Current",
      "values": [
        "home",
        "sessions",
        "profile"
      ],
      "default": "home",
      "ui": "steps"
    }
  },
  "template": "<nav class=\"bottom-nav\" data-current=\"{{current}}\"><div class=\"bottom-nav__tabs\"><button class=\"bottom-nav__tab\" data-tab=\"home\" aria-label=\"Home\"><i class=\"icon icon-home\"></i></button><button class=\"bottom-nav__tab\" data-tab=\"sessions\" aria-label=\"Sessions\"><i class=\"icon icon-clipboard\"></i></button><button class=\"bottom-nav__tab\" data-tab=\"profile\" aria-label=\"Profile\"><i class=\"icon icon-person\"></i></button></div><div class=\"bottom-nav__safe\"><i></i></div></nav>",
  "markup": "<nav class=\"bottom-nav\" data-current=\"home\"><div class=\"bottom-nav__tabs\"><button class=\"bottom-nav__tab\" data-tab=\"home\" aria-label=\"Home\"><i class=\"icon icon-home\"></i></button><button class=\"bottom-nav__tab\" data-tab=\"sessions\" aria-label=\"Sessions\"><i class=\"icon icon-clipboard\"></i></button><button class=\"bottom-nav__tab\" data-tab=\"profile\" aria-label=\"Profile\"><i class=\"icon icon-person\"></i></button></div><div class=\"bottom-nav__safe\"><i></i></div></nav>"
}