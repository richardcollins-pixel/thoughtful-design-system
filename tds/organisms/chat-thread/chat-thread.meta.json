{
  "name": "Chat thread",
  "tier": "organisms",
  "category": "chat",
  "stateful": false,
  "uses": [
    "molecules/chat-message",
    "molecules/fork-option",
    "atoms/button"
  ],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=4446-19046",
  "states": [
    {
      "id": "recommendations",
      "name": "Recommendations",
      "template": "<div class=\"chat-thread\"><div class=\"chat-thread__flow\"><div class=\"chat-thread__messages\" data-slot=\"messages\">{{item:bot1}}{{item:user1}}{{item:bot2}}{{item:user2}}{{item:bot3}}{{item:user3}}</div><div class=\"chat-thread__recs\"><div data-slot=\"rationale\">{{item:rationale}}</div><div class=\"chat-thread__cards\" data-slot=\"options\">{{item:fork1}}{{item:fork2}}</div><div class=\"chat-thread__or\">{{item:or}}</div><div data-slot=\"action\">{{item:save}}</div></div></div></div>",
      "slots": [
        {
          "id": "messages",
          "label": "Messages slot",
          "items": [
            "bot1",
            "user1",
            "bot2",
            "user2",
            "bot3",
            "user3"
          ]
        },
        {
          "id": "rationale",
          "label": "Rationale slot",
          "items": [
            "rationale"
          ]
        },
        {
          "id": "options",
          "label": "Options slot",
          "items": [
            "fork1",
            "fork2"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "save"
          ]
        }
      ],
      "personas": []
    },
    {
      "id": "conversation",
      "name": "Conversation",
      "template": "<div class=\"chat-thread\"><div class=\"chat-thread__flow\"><div class=\"chat-thread__messages\" data-slot=\"messages\">{{item:bot1}}{{item:user1}}{{item:bot2}}</div></div></div>",
      "slots": [
        {
          "id": "messages",
          "label": "Messages slot",
          "items": [
            "bot1",
            "user1",
            "bot2"
          ]
        }
      ],
      "personas": []
    },
    {
      "id": "session",
      "name": "Session",
      "template": "<div class=\"chat-thread\"><div class=\"chat-thread__flow\"><div class=\"chat-thread__messages\" data-slot=\"messages\">{{item:sbot1}}{{item:suser}}{{item:sbot2}}</div></div></div>",
      "slots": [
        {
          "id": "messages",
          "label": "Messages slot",
          "items": [
            "sbot1",
            "suser",
            "sbot2"
          ]
        }
      ],
      "personas": []
    },
    {
      "id": "end",
      "name": "End of session",
      "template": "<div class=\"chat-thread\"><div class=\"chat-thread__flow\"><div class=\"chat-thread__messages\" data-slot=\"messages\">{{item:sbot1}}{{item:suser}}{{item:sbot2}}{{item:suser2}}{{item:slast}}</div></div></div>",
      "slots": [
        {
          "id": "messages",
          "label": "Messages slot",
          "items": [
            "sbot1",
            "suser",
            "sbot2",
            "suser2",
            "slast"
          ]
        }
      ],
      "personas": []
    }
  ],
  "variables": {},
  "styles": [],
  "selector": ".chat-thread",
  "description": "The conversation in a chat: T speaks in plain text, you speak in a bubble. It scrolls and always opens on the newest message. Recommendations ends with two sessions to choose from (5 or 10 minutes) and Save for later.",
  "items": {
    "bot1": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "T message 1",
      "props": {
        "from": "bot",
        "text": "Hi Rich, What’s on your mind?"
      },
      "expose": [
        "text"
      ]
    },
    "user1": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "Your message 1",
      "props": {
        "from": "user",
        "text": "I don't even know where to start. I've been running on empty for weeks. I keep telling myself I just need to get through this sprint, but there's always another one. I'm tired but I can't stop."
      },
      "expose": [
        "text"
      ]
    },
    "bot2": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "T message 2",
      "props": {
        "from": "bot",
        "text": "That sounds exhausting — not just the work, but the part where stopping doesn't even feel like an option. What does \"running on empty\" feel like for you right now — more in your body, your head, or somewhere else?"
      },
      "expose": [
        "text"
      ]
    },
    "user2": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "Your message 2",
      "props": {
        "from": "user",
        "text": "Mostly my head. I can't turn it off. Even at night I'm just mentally rewriting my to-do list."
      },
      "expose": [
        "text"
      ]
    },
    "bot3": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "T message 3",
      "props": {
        "from": "bot",
        "text": "[Summary of what the user shared], [one insight they maybe haven't named themselves]. Does that feel right?"
      },
      "expose": [
        "text"
      ]
    },
    "user3": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "Your message 3",
      "props": {
        "from": "user",
        "text": "yes"
      },
      "expose": [
        "text"
      ]
    },
    "rationale": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "Rationale",
      "props": {
        "from": "bot",
        "text": "[Rationale for the recommendations]"
      },
      "expose": [
        "text"
      ]
    },
    "fork1": {
      "type": "component",
      "component": "molecules/fork-option",
      "label": "Option 1",
      "props": {
        "minutes": "5",
        "tone": "orange",
        "title": "[Bite Size Session Name]",
        "description": "[Rationale for showing this]"
      },
      "expose": [
        "minutes",
        "tone",
        "title",
        "description"
      ]
    },
    "fork2": {
      "type": "component",
      "component": "molecules/fork-option",
      "label": "Option 2",
      "props": {
        "minutes": "10",
        "tone": "rose",
        "title": "[10 min session name]",
        "description": "[Rationale for showing this]"
      },
      "expose": [
        "minutes",
        "tone",
        "title",
        "description"
      ]
    },
    "or": {
      "type": "text",
      "tag": "span",
      "class": "chat-thread__or-label",
      "label": "Divider",
      "value": "OR"
    },
    "save": {
      "type": "component",
      "component": "atoms/button",
      "label": "Save button",
      "props": {
        "label": "Save for later",
        "variant": "filled",
        "size": "lg",
        "width": "full",
        "icon": "bookmark"
      },
      "expose": [
        "label"
      ]
    },
    "sbot1": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "T message 1",
      "props": {
        "from": "bot",
        "text": "Last time, we talked about [insert most recent summary]. This time, let’s [insert suggestion for next steps on this topic]. [Insert a question to start today’s convo]?"
      },
      "expose": [
        "text"
      ]
    },
    "suser": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "Your message",
      "props": {
        "from": "user",
        "text": "I want to feel better about it"
      },
      "expose": [
        "text"
      ]
    },
    "sbot2": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "T message 2",
      "props": {
        "from": "bot",
        "text": "Last time, we talked about [insert most recent summary]. This time, let’s [insert suggestion for next steps on this topic]. [Insert a question to start today’s convo]?"
      },
      "expose": [
        "text"
      ]
    },
    "suser2": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "Your message 2",
      "props": {
        "from": "user",
        "text": "I want to feel better about it"
      },
      "expose": [
        "text"
      ]
    },
    "slast": {
      "type": "component",
      "component": "molecules/chat-message",
      "label": "Last message",
      "props": {
        "from": "bot",
        "text": "This is the last message from the AI…"
      },
      "expose": [
        "text"
      ]
    }
  },
  "personas": [],
  "properties": [],
  "prompts": []
}