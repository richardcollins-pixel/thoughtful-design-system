{
  "name": "Error card",
  "tier": "organisms",
  "category": "cards",
  "stateful": false,
  "uses": [
    "atoms/card",
    "atoms/button"
  ],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=41-3988",
  "states": [
    {
      "id": "default",
      "name": "Default",
      "template": "<article class=\"card error-card\" data-fill=\"flat\"><div class=\"error-card__content\" data-slot=\"content\">{{item:headline}}{{item:body}}</div><div class=\"error-card__action\" data-slot=\"action\">{{item:button}}</div></article>",
      "slots": [
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "headline",
            "body"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "button"
          ]
        }
      ],
      "personas": []
    }
  ],
  "variables": {
    "--card-fill": "fill",
    "--card-radius": "radius"
  },
  "styles": [],
  "selector": ".error-card",
  "description": "Shown in place of a card that couldn't load: what went wrong, how to fix it, and a Retry button.",
  "items": {
    "headline": {
      "type": "text",
      "tag": "h3",
      "class": "error-card__headline",
      "label": "Headline",
      "value": "Couldn't load your therapist info"
    },
    "body": {
      "type": "text",
      "tag": "p",
      "class": "error-card__body",
      "label": "Body Copy",
      "value": "Something went wrong. Tap to try again."
    },
    "button": {
      "type": "component",
      "component": "atoms/button",
      "label": "Retry button",
      "props": {
        "label": "Retry",
        "variant": "filled",
        "size": "md",
        "width": "hug"
      },
      "expose": [
        "label"
      ]
    }
  },
  "personas": [],
  "properties": [
    {
      "id": "radius",
      "label": "Corner Radius",
      "type": "scale",
      "scale": "radius",
      "vars": [
        "--card-radius"
      ],
      "default": "var(--radius-md)",
      "edit": true
    }
  ],
  "prompts": []
}
