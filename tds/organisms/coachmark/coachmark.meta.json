{
  "name": "Coachmark",
  "tier": "organisms",
  "category": "coachmark",
  "stateful": false,
  "uses": [
    "molecules/coachmark-bar",
    "molecules/thoughtstarter",
    "atoms/blob",
    "molecules/coachmark-arrow",
    "molecules/avatar-text"
  ],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=4225-64725",
  "states": [
    {
      "id": "step",
      "name": "Step",
      "template": "<div class=\"coachmark\" data-surface=\"inverse\"><span class=\"coachmark__light\" data-glow-layer aria-hidden=\"true\"></span><div class=\"coachmark__arrow-slot\" data-slot=\"arrow\">{{item:arrow}}</div><div class=\"coachmark__content\" data-slot=\"content\">{{item:header}}{{item:body}}</div><div class=\"coachmark__bar\" data-slot=\"bar\">{{item:bar}}</div></div>",
      "slots": [
        {
          "id": "arrow",
          "label": "Arrow slot",
          "items": [
            "arrow"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "header",
            "body"
          ]
        },
        {
          "id": "bar",
          "label": "Bar slot",
          "items": [
            "bar"
          ]
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {
        "bar": {
          "props": {
            "variant": "dots",
            "step": "1",
            "label": "Next"
          }
        }
      }
    },
    {
      "id": "choice",
      "name": "Choice",
      "template": "<div class=\"coachmark\" data-surface=\"inverse\"><span class=\"coachmark__light\" data-glow-layer aria-hidden=\"true\"></span><div class=\"coachmark__arrow-slot\" data-slot=\"arrow\">{{item:arrow}}</div><div class=\"coachmark__content\" data-slot=\"content\">{{item:header}}</div><div class=\"coachmark__options\" data-slot=\"options\">{{item:opt1}}{{item:opt2}}{{item:opt3}}</div></div>",
      "slots": [
        {
          "id": "arrow",
          "label": "Arrow slot",
          "items": [
            "arrow"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "header"
          ]
        },
        {
          "id": "options",
          "label": "Options slot",
          "items": [
            "opt1",
            "opt2",
            "opt3"
          ]
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {
        "header": {
          "props": {
            "title": "Let’s start together...",
            "avatar": "none",
            "subline": "You don't need to have it figured out",
            "close": "on"
          }
        }
      }
    },
    {
      "id": "single-cta",
      "name": "Single CTA",
      "template": "<div class=\"coachmark\" data-surface=\"inverse\"><span class=\"coachmark__light\" data-glow-layer aria-hidden=\"true\"></span><div class=\"coachmark__arrow-slot\" data-slot=\"arrow\">{{item:arrow}}</div><div class=\"coachmark__content\" data-slot=\"content\">{{item:header}}{{item:body}}</div><div class=\"coachmark__bar\" data-slot=\"bar\">{{item:bar}}</div></div>",
      "slots": [
        {
          "id": "arrow",
          "label": "Arrow slot",
          "items": [
            "arrow"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "header",
            "body"
          ]
        },
        {
          "id": "bar",
          "label": "Bar slot",
          "items": [
            "bar"
          ]
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {
        "header": {
          "props": {
            "title": "Get More From Sessions",
            "avatar": "t-provider"
          }
        },
        "body": {
          "value": "Your support is better when we work together with a therapist. By default, I'll give them a summary on the discoveries that we make together."
        },
        "bar": {
          "props": {
            "variant": "button",
            "label": "Next"
          }
        }
      }
    }
  ],
  "variables": {},
  "styles": [],
  "selector": ".coachmark",
  "description": "A white speech bubble that points at something on screen and explains it. Step has a header, copy and a bar with progress dots and Next; Choice offers a list of thoughtstarters to begin a thought; Single CTA ends in one full-width button. In each, pick the header (T, T with your provider, T as a person icon, or Last), turn the progress dots on or off, and point the arrow up or down at the start, middle or end.",
  "items": {
    "header": {
      "type": "component",
      "component": "molecules/avatar-text",
      "label": "Header",
      "props": {
        "avatar": "t",
        "size": "28",
        "style": "large",
        "title": "Expand your care team"
      },
      "expose": [
        "avatar",
        "title",
        "subline",
        "person",
        "close",
        "icon"
      ]
    },
    "body": {
      "type": "text",
      "tag": "p",
      "class": "coachmark__body",
      "label": "Body Copy",
      "value": "Whenever you're ready, build on our conversations with a therapist"
    },
    "bar": {
      "type": "component",
      "component": "molecules/coachmark-bar",
      "label": "Bar",
      "props": {
        "variant": "dots",
        "step": "1",
        "label": "Next"
      },
      "expose": [
        "variant",
        "step",
        "label"
      ]
    },
    "opt1": {
      "type": "component",
      "component": "molecules/thoughtstarter",
      "label": "Option 1",
      "props": {
        "text": "I've never mentioned this to anyone, but..."
      },
      "expose": [
        "text"
      ]
    },
    "opt2": {
      "type": "component",
      "component": "molecules/thoughtstarter",
      "label": "Option 2",
      "props": {
        "text": "I'm always there for others, but lately..."
      },
      "expose": [
        "text"
      ]
    },
    "opt3": {
      "type": "component",
      "component": "molecules/thoughtstarter",
      "label": "Option 3",
      "props": {
        "text": "✏️ I’ll write my own"
      },
      "expose": [
        "text"
      ]
    },
    "arrow": {
      "type": "component",
      "component": "molecules/coachmark-arrow",
      "label": "Arrow",
      "props": {
        "direction": "up",
        "position": "center"
      },
      "expose": [
        "direction",
        "position"
      ]
    }
  },
  "personas": [
    "provider"
  ],
  "properties": [],
  "prompts": []
}