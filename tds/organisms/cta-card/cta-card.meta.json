{
  "name": "CTA card",
  "tier": "organisms",
  "category": "cards",
  "stateful": false,
  "uses": [
    "atoms/card",
    "atoms/button",
    "molecules/skeleton-text"
  ],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=41-3988",
  "states": [
    {
      "id": "default",
      "name": "Default",
      "template": "<article class=\"card cta-card\"><div class=\"cta-card__content\" data-slot=\"content\">{{item:headline}}{{item:body}}</div><div class=\"cta-card__action\" data-slot=\"action\">{{item:button}}</div></article>",
      "slots": [
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "headline",
            "body"
          ],
          "skeleton": true
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "button"
          ]
        }
      ],
      "personas": []
    }
  ],
  "variables": {
    "--card-fill": "fill",
    "--card-radius": "radius"
  },
  "styles": [],
  "selector": ".cta-card",
  "description": "A short pitch with one big button: a serif headline, a line or two of copy and a filled button. Use it to ask for the next step.",
  "items": {
    "headline": {
      "type": "text",
      "tag": "h3",
      "class": "cta-card__headline",
      "label": "Headline",
      "value": "Headline goes here",
      "skeleton": {
        "lines": 1
      }
    },
    "body": {
      "type": "text",
      "tag": "p",
      "class": "cta-card__body",
      "label": "Body Copy",
      "value": "Body copy goes here. Lorem ipsum dolor sit amet, consectetur adipiscing elit."
    },
    "button": {
      "type": "component",
      "component": "atoms/button",
      "label": "Button",
      "props": {
        "label": "Button",
        "variant": "filled",
        "size": "lg",
        "width": "full"
      },
      "expose": [
        "label"
      ]
    }
  },
  "personas": [],
  "properties": [
    {
      "id": "background",
      "label": "Background Color",
      "type": "gradients",
      "var": "--card-fill",
      "default": "var(--gradient-purple-to-blue)"
    },
    {
      "id": "radius",
      "label": "Corner Radius",
      "type": "scale",
      "scale": "radius",
      "vars": [
        "--card-radius"
      ],
      "default": "var(--radius-md)",
      "edit": true
    }
  ],
  "prompts": []
}
