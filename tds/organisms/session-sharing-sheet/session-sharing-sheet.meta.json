{
  "name": "Session sharing sheet",
  "tier": "organisms",
  "category": "sheets",
  "stateful": false,
  "uses": [
    "atoms/sheet",
    "atoms/avatar",
    "atoms/blob",
    "atoms/button",
    "molecules/toggle-row"
  ],
  "figma": "https://www.figma.com/design/2dd93uRGMkAzwfaUu9CcSi/Session-Sharing?node-id=629-3943",
  "states": [
    {
      "id": "off",
      "name": "Sharing",
      "template": "<div class=\"sheet session-sharing\"><span class=\"sheet__handle\"></span><div class=\"session-sharing__main\"><div class=\"session-sharing__intro\" data-slot=\"content\"><div class=\"session-sharing__title\"><span class=\"session-sharing__icons\"><span class=\"blob\" style=\"--blob-size:28px\"><canvas aria-hidden=\"true\"></canvas></span>{{item:avatar}}</span>{{item:headline}}</div>{{item:body}}<ul class=\"session-sharing__list\">{{item:b1}}{{item:b2}}{{item:b3}}</ul></div><div class=\"session-sharing__group\" data-slot=\"toggle\">{{item:toggle}}<hr class=\"session-sharing__rule\"><div class=\"session-sharing__safety\"><i class=\"icon icon-help\"></i>{{item:safety}}</div></div></div><div class=\"session-sharing__action\" data-slot=\"action\">{{item:done}}</div></div>",
      "slots": [
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "avatar",
            "headline",
            "body",
            "b1",
            "b2",
            "b3"
          ]
        },
        {
          "id": "toggle",
          "label": "Toggle slot",
          "items": [
            "toggle",
            "safety"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "done"
          ]
        }
      ],
      "personas": [
        "provider"
      ]
    },
    {
      "id": "off-record",
      "name": "Off the record",
      "template": "<div class=\"sheet session-sharing\"><span class=\"sheet__handle\"></span><div class=\"session-sharing__main\"><div class=\"session-sharing__intro\" data-slot=\"content\"><div class=\"session-sharing__title\"><span class=\"session-sharing__icons\"><span class=\"blob\" style=\"--blob-size:28px\"><canvas aria-hidden=\"true\"></canvas></span>{{item:avatar}}</span>{{item:headline}}</div>{{item:body}}<ul class=\"session-sharing__list\">{{item:b1}}{{item:b2}}{{item:b3}}</ul></div><div class=\"session-sharing__group\" data-slot=\"toggle\">{{item:toggle}}<hr class=\"session-sharing__rule\"><div class=\"session-sharing__safety\"><i class=\"icon icon-help\"></i>{{item:safety}}</div></div></div><div class=\"session-sharing__action\" data-slot=\"action\">{{item:done}}</div></div>",
      "slots": [
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "avatar",
            "headline",
            "body",
            "b1",
            "b2",
            "b3"
          ]
        },
        {
          "id": "toggle",
          "label": "Toggle slot",
          "items": [
            "toggle",
            "safety"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "done"
          ]
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {
        "toggle": {
          "props": {
            "on": "true"
          }
        }
      }
    }
  ],
  "variables": {},
  "styles": [],
  "selector": ".session-sharing",
  "description": "The bottom sheet behind the record icon in a chat. It explains that your therapist gets a short recap of the session, and lets you go off the record: Sharing has the toggle off, Off the record has it on. A line at the bottom says the care team is told if a conversation raises a safety concern.",
  "items": {
    "avatar": {
      "type": "component",
      "component": "atoms/avatar",
      "label": "Provider",
      "props": {
        "size": "sm"
      },
      "expose": [
        "person"
      ],
      "bind": {
        "person": "provider"
      }
    },
    "headline": {
      "type": "text",
      "tag": "h2",
      "class": "session-sharing__headline",
      "label": "Headline",
      "value": "Your support is better when {{provider-name}} is up to speed"
    },
    "body": {
      "type": "text",
      "tag": "p",
      "class": "session-sharing__body",
      "label": "Body Copy",
      "value": "They get a short recap of what you covered so you can spend your appointment going deeper, not catching up."
    },
    "b1": {
      "type": "text",
      "tag": "li",
      "class": "session-sharing__bullet",
      "label": "Bullet 1",
      "value": "We’re all on the same page"
    },
    "b2": {
      "type": "text",
      "tag": "li",
      "class": "session-sharing__bullet",
      "label": "Bullet 2",
      "value": "Nothing gets lost between appointments"
    },
    "b3": {
      "type": "text",
      "tag": "li",
      "class": "session-sharing__bullet",
      "label": "Bullet 3",
      "value": "Build on discoveries we make together"
    },
    "toggle": {
      "type": "component",
      "component": "molecules/toggle-row",
      "label": "Toggle row",
      "props": {
        "title": "Go off the record",
        "sub": "Keep this between you and T",
        "on": "false"
      },
      "expose": [
        "title",
        "sub",
        "on"
      ]
    },
    "safety": {
      "type": "text",
      "tag": "p",
      "class": "session-sharing__safety-text",
      "label": "Safety note",
      "value": "Our care team will be notified if any conversation raises a safety concern"
    },
    "done": {
      "type": "component",
      "component": "atoms/button",
      "label": "Button",
      "props": {
        "label": "Done",
        "variant": "filled",
        "size": "md",
        "width": "full"
      },
      "expose": [
        "label"
      ]
    }
  },
  "personas": [
    "provider"
  ],
  "properties": [],
  "prompts": []
}