{
  "name": "Session history card",
  "tier": "organisms",
  "category": "cards",
  "stateful": false,
  "uses": [
    "atoms/card",
    "atoms/avatar",
    "atoms/icon-button",
    "molecules/icon-label",
    "molecules/skeleton-text"
  ],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=41-3988",
  "states": [
    {
      "id": "default",
      "name": "Default",
      "template": "<article class=\"card session-history-card\"><div class=\"session-history-card__content\" data-slot=\"content\"><div class=\"session-history-card__titles\">{{item:overline}}{{item:headline}}</div>{{item:body}}{{item:duration}}</div><div class=\"session-history-card__action\" data-slot=\"action\">{{item:next}}</div></article>",
      "slots": [
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "overline",
            "headline",
            "body",
            "duration"
          ],
          "skeleton": true
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "next"
          ]
        }
      ],
      "personas": []
    },
    {
      "id": "image",
      "name": "With image",
      "template": "<article class=\"card session-history-card\"><div class=\"session-history-card__content\" data-slot=\"content\"><div class=\"session-history-card__titles\">{{item:overline}}<div class=\"session-history-card__title-row\">{{item:photo}}{{item:headline}}</div></div>{{item:body}}{{item:duration}}</div><div class=\"session-history-card__action\" data-slot=\"action\">{{item:next}}</div></article>",
      "slots": [
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "overline",
            "photo",
            "headline",
            "body",
            "duration"
          ],
          "skeleton": true
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "next"
          ]
        }
      ],
      "personas": [
        "provider"
      ]
    }
  ],
  "variables": {
    "--card-fill": "fill",
    "--card-radius": "radius"
  },
  "styles": [],
  "selector": ".session-history-card",
  "description": "A past session in a list: overline, headline, a few lines of copy and how long it was, with an arrow button to open it. The With image state puts a small photo before the headline.",
  "items": {
    "overline": {
      "type": "text",
      "tag": "p",
      "class": "session-history-card__overline",
      "label": "Overline",
      "value": "Overline",
      "skeleton": {
        "lines": 1
      }
    },
    "headline": {
      "type": "text",
      "tag": "h3",
      "class": "session-history-card__headline",
      "label": "Headline",
      "value": "Headline goes here",
      "skeleton": {
        "lines": 1
      }
    },
    "body": {
      "type": "text",
      "tag": "p",
      "class": "session-history-card__body",
      "label": "Body Copy",
      "value": "Body copy goes here. Lorem ipsum dolor sit amet, consectetur adipiscing elit."
    },
    "photo": {
      "type": "component",
      "component": "atoms/avatar",
      "label": "Photo",
      "props": {
        "size": "sm"
      },
      "expose": [
        "person"
      ],
      "bind": {
        "person": "provider"
      }
    },
    "duration": {
      "type": "component",
      "component": "molecules/icon-label",
      "label": "Duration",
      "props": {
        "icon": "clock",
        "text": "5 min",
        "emphasis": "primary",
        "size": "md"
      },
      "expose": [
        "text",
        "icon"
      ]
    },
    "next": {
      "type": "component",
      "component": "atoms/icon-button",
      "label": "Open button",
      "props": {
        "icon": "chevron-right",
        "elevation": "40",
        "size": "md"
      },
      "expose": [
        "icon"
      ]
    }
  },
  "personas": [],
  "properties": [
    {
      "id": "background",
      "label": "Background Color",
      "type": "gradients",
      "var": "--card-fill",
      "default": "var(--gradient-purple-to-blue)"
    },
    {
      "id": "radius",
      "label": "Corner Radius",
      "type": "scale",
      "scale": "radius",
      "vars": [
        "--card-radius"
      ],
      "default": "var(--radius-md)",
      "edit": true
    }
  ],
  "prompts": []
}
