{
  "name": "Therapist Card",
  "tier": "organisms",
  "category": "cards",
  "stateful": false,
  "uses": ["atoms/avatar", "atoms/button", "atoms/icon", "molecules/icon-label"],
  "markup": "<article class=\"therapist-card\"><header class=\"therapist-card__head\"><span class=\"avatar\" data-size=\"lg\"><img src=\"../tds/assets/images/therapists/Therapist-2.png\" alt=\"\"></span><div><h3 class=\"therapist-card__name\">Maya Patel</h3><p class=\"therapist-card__role\">Licensed clinical social worker</p></div></header><div class=\"therapist-card__details\"><div class=\"icon-label\"><i class=\"icon icon-calendar\" data-size=\"sm\"></i><span>Next available Tue, Oct 13 · 2:30 PM</span></div><div class=\"icon-label\"><i class=\"icon icon-video-chat\" data-size=\"sm\"></i><span>Video visits</span></div></div><button class=\"button\" data-width=\"full\">Book a session</button></article>",
  "attributes": {
    "data-variant": { "type": "enum", "values": ["detailed", "compact"], "default": "detailed" }
  },
  "states": [],
  "variables": {
    "--therapist-card-fill": "color",
    "--therapist-card-border": "color",
    "--therapist-card-radius": "radius",
    "--therapist-card-padding": "padding",
    "--therapist-card-gap": "padding"
  },
  "styles": []
}
