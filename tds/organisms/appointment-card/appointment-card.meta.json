{
  "name": "Appointment card",
  "tier": "organisms",
  "category": "cards",
  "stateful": false,
  "uses": [
    "atoms/card",
    "atoms/avatar",
    "atoms/button",
    "atoms/icon-button",
    "atoms/icon",
    "molecules/icon-label",
    "molecules/avatar-group"
  ],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=41-3988",
  "states": [],
  "variables": {
    "--card-fill": "fill",
    "--card-padding-x": "padding",
    "--card-padding-y": "padding",
    "--card-radius": "radius",
    "--card-gap": "padding"
  },
  "styles": [],
  "selector": ".appointment-card",
  "description": "The home-screen card about the user's care. Use Booked to show an upcoming appointment, No appointment to prompt booking, and Provider CTA to invite choosing a provider. One card shows at a time.",
  "items": {
    "avatar": {
      "type": "component",
      "component": "atoms/avatar",
      "label": "Avatar",
      "props": {
        "person": "kristina",
        "size": "md"
      },
      "expose": [
        "person"
      ]
    },
    "group": {
      "type": "component",
      "component": "molecules/avatar-group",
      "label": "Avatar group",
      "props": {},
      "expose": []
    },
    "headline": {
      "type": "text",
      "tag": "h3",
      "class": "appointment-card__headline",
      "label": "Headline",
      "value": "Appointment with {{therapist-name}}"
    },
    "edit": {
      "type": "component",
      "component": "atoms/icon-button",
      "label": "Icon Button",
      "props": {
        "elevation": "0",
        "size": "xs",
        "icon": "edit"
      },
      "expose": [
        "elevation",
        "icon"
      ]
    },
    "date": {
      "type": "component",
      "component": "molecules/icon-label",
      "label": "Label",
      "props": {
        "text": "Wed, Jun 4 at 10:00 am",
        "icon": "calendar",
        "emphasis": "primary",
        "size": "md"
      },
      "expose": [
        "text",
        "icon"
      ]
    },
    "duration": {
      "type": "component",
      "component": "molecules/icon-label",
      "label": "Label",
      "props": {
        "text": "1 hr",
        "icon": "clock",
        "emphasis": "primary",
        "size": "md"
      },
      "expose": [
        "text",
        "icon"
      ]
    },
    "body": {
      "type": "text",
      "tag": "p",
      "class": "appointment-card__body",
      "label": "Body Copy",
      "value": "Body copy goes here. Lorem ipsum dolor sit amet, consectetur adipiscing elit."
    },
    "footnote": {
      "type": "text",
      "tag": "p",
      "class": "appointment-card__footnote",
      "label": "Footnote",
      "value": "Footnote goes here"
    },
    "button": {
      "type": "component",
      "component": "atoms/button",
      "label": "Button",
      "props": {
        "label": "Book a session",
        "variant": "filled",
        "size": "md",
        "width": "full"
      },
      "expose": [
        "label"
      ]
    }
  },
  "layouts": [
    {
      "id": "booked",
      "name": "Booked",
      "template": "<article class=\"card appointment-card\" data-layout=\"row\"><div class=\"appointment-card__row\">{{item:avatar}}<div class=\"appointment-card__main\"><div class=\"appointment-card__titles\"><div class=\"appointment-card__title-row\">{{item:headline}}{{item:edit}}</div><div class=\"appointment-card__details\">{{item:date}}{{item:duration}}</div></div>{{item:body}}{{item:footnote}}</div></div></article>",
      "slots": [
        {
          "label": "Slot 1",
          "items": [
            "avatar",
            "headline",
            "edit",
            "date",
            "duration"
          ]
        },
        {
          "label": "Slot 2",
          "items": [
            "body",
            "footnote"
          ]
        }
      ]
    },
    {
      "id": "no-appointment",
      "name": "No appointment",
      "template": "<article class=\"card appointment-card\" data-layout=\"row\"><div class=\"appointment-card__row\">{{item:avatar}}<div class=\"appointment-card__main appointment-card__main--tight\">{{item:headline}}{{item:body}}</div></div>{{item:button}}</article>",
      "overrides": {
        "headline": {
          "value": "Ready to book your next session?"
        },
        "body": {
          "value": "Pick a time that works for you and we'll take care of the rest."
        }
      },
      "slots": [
        {
          "label": "Slot 1",
          "items": [
            "avatar",
            "headline",
            "body"
          ]
        },
        {
          "label": "Slot 2",
          "items": [
            "button"
          ]
        }
      ]
    },
    {
      "id": "provider-cta",
      "name": "Provider CTA",
      "template": "<article class=\"card appointment-card\" data-layout=\"centered\">{{item:group}}<div class=\"appointment-card__main\">{{item:headline}}{{item:body}}</div>{{item:button}}</article>",
      "overrides": {
        "headline": {
          "value": "Find your match"
        },
        "body": {
          "value": "Browse providers who fit what you're looking for."
        },
        "button": {
          "props": {
            "label": "See providers"
          }
        }
      },
      "slots": [
        {
          "label": "Slot 1",
          "items": [
            "group",
            "headline",
            "body"
          ]
        },
        {
          "label": "Slot 2",
          "items": [
            "button"
          ]
        }
      ]
    }
  ],
  "properties": [
    {
      "id": "background",
      "label": "Background Color",
      "type": "gradients",
      "var": "--card-fill",
      "default": "var(--gradient-purple-to-blue)"
    },
    {
      "id": "radius",
      "label": "Corner Radius",
      "type": "scale",
      "scale": "radius",
      "vars": [
        "--card-radius"
      ],
      "default": "var(--radius-md)"
    },
    {
      "id": "padding",
      "label": "Padding",
      "type": "scale",
      "scale": "padding",
      "vars": [
        "--card-padding-x",
        "--card-padding-y"
      ]
    }
  ]
}
