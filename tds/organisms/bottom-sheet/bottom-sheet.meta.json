{
  "name": "Bottom sheet",
  "tier": "organisms",
  "category": "sheets",
  "stateful": false,
  "uses": [
    "atoms/button"
  ],
  "figma": "https://www.figma.com/design/2dd93uRGMkAzwfaUu9CcSi/Session-Sharing?node-id=629-3943",
  "states": [
    {
      "id": "default",
      "name": "Default",
      "template": "<div class=\"bottom-sheet\"><span class=\"bottom-sheet__handle\"></span><div class=\"bottom-sheet__header\" data-slot=\"header\">{{item:title}}{{item:intro}}</div><div class=\"bottom-sheet__content\" data-slot=\"content\">{{item:body}}</div><div class=\"bottom-sheet__action\" data-slot=\"action\">{{item:action}}</div></div>",
      "slots": [
        {
          "id": "header",
          "label": "Header slot",
          "items": [
            "title",
            "intro"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "body"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "action"
          ]
        }
      ],
      "personas": []
    },
    {
      "id": "no-header",
      "name": "No header",
      "template": "<div class=\"bottom-sheet\"><span class=\"bottom-sheet__handle\"></span><div class=\"bottom-sheet__content\" data-slot=\"content\">{{item:body}}</div><div class=\"bottom-sheet__action\" data-slot=\"action\">{{item:action}}</div></div>",
      "slots": [
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "body"
          ]
        },
        {
          "id": "action",
          "label": "Action slot",
          "items": [
            "action"
          ]
        }
      ],
      "personas": []
    }
  ],
  "variables": {},
  "styles": [],
  "selector": ".bottom-sheet",
  "align": "bottom",
  "description": "The shell every bottom sheet shares: a slate surface with 24px top corners and a pull handle, over a dimmed backdrop, with three slots that always sit in the same order: Header (a headline and a line of copy), Content (whatever the sheet is for) and Action (the main button). It runs full width and clings to the bottom. Patterns such as the session sharing sheet and the feedback sheet choose what goes in each slot.",
  "items": {
    "title": {
      "type": "text",
      "tag": "h2",
      "class": "bottom-sheet__title",
      "label": "Headline",
      "value": "Headline goes here"
    },
    "intro": {
      "type": "text",
      "tag": "p",
      "class": "bottom-sheet__intro",
      "label": "Intro",
      "value": "A line or two of copy goes here to say what the sheet is for."
    },
    "body": {
      "type": "text",
      "tag": "p",
      "class": "bottom-sheet__body",
      "label": "Content",
      "value": "Whatever the sheet is for goes in the content slot."
    },
    "action": {
      "type": "component",
      "component": "atoms/button",
      "label": "Button",
      "props": {
        "label": "Done",
        "variant": "filled",
        "size": "md",
        "width": "full"
      },
      "expose": [
        "label"
      ]
    }
  },
  "personas": [],
  "properties": [],
  "prompts": []
}