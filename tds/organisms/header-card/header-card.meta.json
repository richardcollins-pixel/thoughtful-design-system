{
  "name": "Header card",
  "tier": "organisms",
  "category": "cards",
  "stateful": false,
  "uses": [
    "atoms/card",
    "atoms/avatar",
    "molecules/icon-label",
    "molecules/skeleton-text",
    "molecules/header",
    "molecules/avatar-text",
    "molecules/chat-input"
  ],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=41-3988",
  "states": [
    {
      "id": "default",
      "name": "Default",
      "template": "<article class=\"card header-card\" data-variant=\"default\"><div class=\"header-card__top\" data-slot=\"top\">{{item:header}}</div><div class=\"header-card__content\" data-slot=\"content\"><div class=\"header-card__titles\">{{item:overline}}{{item:headline}}</div>{{item:body}}<div class=\"header-card__labels\" data-slot=\"labels\">{{item:duration}}{{item:label2}}</div></div></article>",
      "slots": [
        {
          "id": "top",
          "label": "Top slot",
          "items": [
            "header"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "overline",
            "headline",
            "body",
            "duration"
          ],
          "skeleton": true
        },
        {
          "id": "labels",
          "label": "Labels slot",
          "items": [
            "duration",
            "label2"
          ]
        }
      ],
      "personas": []
    },
    {
      "id": "provider",
      "name": "Provider",
      "template": "<article class=\"card header-card\" data-variant=\"provider\"><div class=\"header-card__top\" data-slot=\"top\">{{item:header}}</div><div class=\"header-card__content\" data-slot=\"content\">{{item:photo}}<div class=\"header-card__titles\">{{item:overline}}{{item:headline}}</div>{{item:body}}<div class=\"header-card__labels\" data-slot=\"labels\">{{item:duration}}{{item:label2}}</div></div></article>",
      "slots": [
        {
          "id": "top",
          "label": "Top slot",
          "items": [
            "header"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "photo",
            "overline",
            "headline",
            "body",
            "duration"
          ],
          "skeleton": true
        },
        {
          "id": "labels",
          "label": "Labels slot",
          "items": [
            "duration",
            "label2"
          ]
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {
        "duration": {
          "props": {
            "text": "1 hr"
          }
        }
      }
    },
    {
      "id": "prompt",
      "name": "Follow-up prompt",
      "template": "<article class=\"card header-card\" data-variant=\"prompt\"><span class=\"header-card__light\" data-glow-layer aria-hidden=\"true\"></span><div class=\"header-card__top\" data-slot=\"top\">{{item:header}}</div><div class=\"header-card__content\" data-slot=\"content\">{{item:photo}}<div class=\"header-card__titles\">{{item:overline}}{{item:headline}}</div><div class=\"header-card__chat\" data-slot=\"chat\">{{item:chat}}{{item:prompt}}</div></div></article>",
      "slots": [
        {
          "id": "top",
          "label": "Top slot",
          "items": [
            "header"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "photo",
            "overline",
            "headline",
            "chat",
            "prompt"
          ],
          "skeleton": true
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {
        "headline": {
          "value": "Appointment with Kristina"
        }
      }
    },
    {
      "id": "hero",
      "name": "Hero, warm",
      "template": "<article class=\"card header-card\" data-variant=\"hero\"><div class=\"header-card__top\" data-slot=\"top\">{{item:header}}</div><div class=\"header-card__content\" data-slot=\"content\"><div class=\"header-card__titles\">{{item:headline}}</div></div></article>",
      "slots": [
        {
          "id": "top",
          "label": "Top slot",
          "items": [
            "header"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "headline"
          ]
        }
      ],
      "personas": [],
      "overrides": {
        "header": {
          "props": {
            "variant": "sub-section",
            "title": "Support"
          }
        },
        "headline": {
          "value": "How can we help?"
        }
      }
    },
    {
      "id": "hero-cool",
      "name": "Hero, cool",
      "template": "<article class=\"card header-card\" data-variant=\"hero-cool\"><div class=\"header-card__top\" data-slot=\"top\">{{item:header}}</div><div class=\"header-card__content\" data-slot=\"content\"><div class=\"header-card__titles\">{{item:headline}}</div></div></article>",
      "slots": [
        {
          "id": "top",
          "label": "Top slot",
          "items": [
            "header"
          ]
        },
        {
          "id": "content",
          "label": "Content slot",
          "items": [
            "headline"
          ]
        }
      ],
      "personas": [],
      "overrides": {
        "header": {
          "props": {
            "variant": "sub-section",
            "title": "Support"
          }
        },
        "headline": {
          "value": "How can we help?"
        }
      }
    }
  ],
  "variables": {
    "--card-fill": "fill",
    "--card-radius": "radius"
  },
  "styles": [],
  "selector": ".header-card",
  "description": "The card that opens a screen, with the header (status bar and close button) on top: it runs to the screen edges and its bottom corners are rounded. Default is the colorful one with an overline, headline, a line of copy and a duration. Provider is the quiet one with the provider's photo on top. Hero is the title page version: the back button and page title on top and one big centered headline, in the warm gradient (Support) or the cool one (About).",
  "items": {
    "photo": {
      "type": "component",
      "component": "atoms/avatar",
      "label": "Photo",
      "props": {
        "size": "lg"
      },
      "bind": {
        "person": "provider"
      },
      "expose": [
        "person"
      ]
    },
    "overline": {
      "type": "text",
      "tag": "p",
      "class": "header-card__overline",
      "label": "Overline",
      "value": "Overline",
      "skeleton": {
        "lines": 1
      }
    },
    "headline": {
      "type": "text",
      "tag": "h2",
      "class": "header-card__headline",
      "label": "Headline",
      "value": "Headline goes here",
      "skeleton": {
        "lines": 1
      }
    },
    "body": {
      "type": "text",
      "tag": "p",
      "class": "header-card__body",
      "label": "Body Copy",
      "value": "Body copy goes here. Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
      "skeleton": {
        "lines": 2
      }
    },
    "duration": {
      "type": "component",
      "component": "molecules/icon-label",
      "label": "Duration",
      "props": {
        "icon": "clock",
        "text": "5 min",
        "emphasis": "primary",
        "size": "md"
      },
      "expose": [
        "text",
        "icon"
      ]
    },
    "header": {
      "type": "component",
      "component": "molecules/header",
      "label": "Header",
      "props": {
        "variant": "close"
      },
      "expose": [
        "variant",
        "title",
        "action",
        "step"
      ]
    },
    "label2": {
      "type": "component",
      "component": "molecules/icon-label",
      "label": "Label 2",
      "props": {
        "icon": "person-x",
        "text": "Off the Record",
        "emphasis": "primary",
        "size": "md",
        "show": "off"
      },
      "expose": [
        "text",
        "icon"
      ]
    },
    "chat": {
      "type": "component",
      "component": "molecules/avatar-text",
      "label": "T line",
      "props": {
        "avatar": "t",
        "size": "24",
        "style": "chat",
        "title": "I’m here to chat"
      },
      "expose": [
        "title"
      ]
    },
    "prompt": {
      "type": "component",
      "component": "molecules/chat-input",
      "label": "Follow-up prompt",
      "props": {
        "variant": "large",
        "text": "Want to follow up on [three to four generated words]?"
      },
      "expose": [
        "text"
      ]
    }
  },
  "personas": [],
  "properties": [
    {
      "id": "background",
      "label": "Background Color",
      "type": "gradients",
      "var": "--card-fill",
      "default": "var(--gradient-dark-rose-to-orange)",
      "flatStates": [
        "provider"
      ]
    },
    {
      "id": "radius",
      "label": "Corner Radius",
      "type": "scale",
      "scale": "radius",
      "vars": [
        "--header-radius"
      ],
      "default": "calc(var(--radius-lg) * 2)",
      "edit": true
    }
  ],
  "prompts": [
    {
      "id": "header-copy",
      "label": "Header copy",
      "instruction": "Write a short overline, a headline and one sentence of body copy that introduce this screen. Calm and warm.",
      "inputs": [
        "state"
      ],
      "outputs": [
        "overline",
        "headline",
        "body"
      ],
      "note": "Placeholder prompt to show the structure; nothing runs it yet."
    }
  ],
  "align": "top",
  "inputs": [
    {
      "id": "session",
      "label": "Session",
      "type": "select",
      "item": "duration",
      "prop": "text",
      "options": [
        {
          "value": "5 min"
        },
        {
          "value": "10 min"
        },
        {
          "value": "30 min"
        },
        {
          "value": "1 hr"
        }
      ]
    },
    {
      "id": "label",
      "label": "Label",
      "type": "select",
      "options": [
        {
          "value": "none",
          "label": "None",
          "set": [
            [
              "label2",
              "show",
              "off"
            ],
            [
              "duration",
              "show",
              "on"
            ]
          ]
        },
        {
          "value": "otr",
          "label": "Off the record",
          "set": [
            [
              "label2",
              "show",
              "on"
            ],
            [
              "label2",
              "icon",
              "person-x"
            ],
            [
              "label2",
              "text",
              "Off the Record"
            ],
            [
              "duration",
              "show",
              "on"
            ]
          ]
        },
        {
          "value": "saved",
          "label": "Leave it with T",
          "set": [
            [
              "label2",
              "show",
              "on"
            ],
            [
              "label2",
              "icon",
              "bookmark"
            ],
            [
              "label2",
              "text",
              "Leave it with T"
            ],
            [
              "duration",
              "show",
              "off"
            ]
          ]
        }
      ]
    }
  ]
}