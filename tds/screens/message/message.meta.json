  "variables": {},
  "styles": [],
  "selector": ".message",
  "description": "A full screen with one message from T: T, a headline, a few lines, and a button or two, with a footer note when there is somewhere to turn. States: No connection, Get the latest app (with Skip), Update required, Someone might reach out, No match found (the matches screen when there is no therapist nearby) and Not a good fit (what the safety check leads to).",
  "items": {
    "header": {
      "type": "component",
      "component": "molecules/header",
      "label": "Header",
      "props": {
        "variant": "sub-section",
        "title": "Your Matches"
      },
      "expose": [
        "title"
      ]
    },
    "blob": {
      "type": "component",
      "component": "atoms/blob",
      "label": "T",
      "props": {
        "theme": "rose"
      },
      "expose": [
        "shape",
        "theme"
      ],
      "required": true
    },
    "title": {
      "type": "text",
      "tag": "h1",
      "class": "message__title",
      "label": "Headline",
      "value": "No connection"
    },
    "body": {
      "type": "text",
      "tag": "p",
      "class": "message__body",
      "label": "Body Copy",
      "value": "Your connection is very slow at the moment or you’re disconnected from the internet. Please check your settings and try again."
    },
    "primary": {
      "type": "component",
      "component": "atoms/button",
      "label": "Primary button",
      "props": {
        "label": "Try Again",
        "variant": "filled",
        "size": "md",
        "width": "full"
      },
      "expose": [
        "label"
      ]
    },
    "secondary": {
      "type": "component",
      "component": "atoms/button",
      "label": "Secondary button",
      "props": {
        "label": "Skip Update",
        "variant": "flat",
        "size": "sm",
        "width": "hug"
      },
      "expose": [
        "label"
      ]
    },
    "contact": {
      "type": "text",
      "tag": "p",
      "class": "message__contact",
      "label": "Contact line",
      "value": "Reach out to careteam@thoughtful.com"
    },
    "pinned": {
      "type": "component",
      "component": "atoms/button",
      "label": "Bottom button",
      "props": {
        "label": "Continue",
        "variant": "filled",
        "size": "md",
        "width": "full"
      },
      "expose": [
        "label"
      ]
    },
    "note": {
      "type": "text",
      "tag": "span",
      "class": "message__note-text",
      "label": "Footer note",
      "value": "If you think this is an error, please reach out to"
    },
    "email": {
      "type": "text",
      "tag": "b",
      "class": "message__note-email",
      "label": "Footer email",
      "value": "careteam@thoughtful.com"
    },
    "nav": {
      "type": "component",
      "component": "molecules/bottom-nav",
      "label": "Bottom nav",
      "props": {
        "current": "sessions",
        "tabs": "2"
      },
      "expose": [
        "current",
        "tabs"
      ]
    },
    "status": {
      "type": "component",
      "component": "device/status-bar",
      "label": "Status bar",
      "props": {},
