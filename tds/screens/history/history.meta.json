  "variables": {},
  "styles": [],
  "selector": ".history",
  "description": "The history screen: a title bar, then a list of past sessions as session history cards (the first one with the provider’s photo, off the record), and the bottom nav on Sessions. The title bar and the nav are blurred over the cards as they scroll.",
  "items": {
    "header": {
      "type": "component",
      "component": "molecules/header",
      "label": "Header",
      "props": {
        "variant": "section-root",
        "title": "History"
      },
      "expose": [
        "title"
      ]
    },
    "c1": {
      "type": "component",
      "component": "organisms/session-history-card",
      "label": "Session 1",
      "props": {
        "state": "off-record",
        "overline": "Thurs, Oct 20 1:15pm",
        "headline": "Managing Financial Stress",
        "body": "You mentioned feeling anxious at work. We could slow this down together and look at what might help you feel more steady going into your day.",
        "duration.text": "10 min"
      },
      "expose": [
        "state",
        "overline",
        "headline",
        "body",
        "duration.text"
      ]
    },
    "c2": {
