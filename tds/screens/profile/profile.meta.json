    "welcome": {
      "type": "component",
      "component": "molecules/text-section",
      "label": "Welcome",
      "props": {
        "heading": "Welcome to Thoughtful",
        "body": "Thoughtful is your personal, AI-powered support tool, here to help you build skills and emotional resilience.\n\nGet safe, private, and unlimited guidance that's tailored specifically to your needs. The system uses a skills-based approach and was designed with input from clinicians, ensuring you get a structured, supportive experience every time."
      },
      "expose": [
        "heading",
        "body"
      ]
    },
    "how": {
      "type": "component",
      "component": "molecules/text-section",
      "label": "How it works",
      "props": {
        "heading": "How it works",
        "body": "Thoughtful uses Artificial Intelligence (AI) to provide personalized support and guidance based on what you choose to share.\n\nSkills-Based Sessions: You select a session length designed to teach you emotional resilience skills.\n\nPersonalized Chat: The AI chat gives you immediate support, tracks your progress, and guides you through structured techniques.\n\nReview and Track: You can review past sessions and learnings in your private Session History and skill library, seeing the real skills you've developed."
      },
      "expose": [
        "heading",
        "body"
      ]
    },
    "privacy": {
      "type": "component",
      "component": "molecules/text-section",
      "label": "Your Data is Private",
      "props": {
        "heading": "Your Data is Private",
        "body": "Your Privacy is Paramount. As a mental wellness tool, your information is treated with the highest level of security and respect.\n\nSecurity: Your sessions are private, safe, and secure. All data is encrypted and stored securely.\n\nData Use: The data you share is only used to personalize your experience and improve the quality of the guidance and support you receive.\n\nNo Selling or Sharing: Your data is never sold or shared with third parties for marketing or advertising.\n\nFor a complete and detailed breakdown of data practices, please review the Privacy Policy."
      },
      "expose": [
        "heading",
        "body"
      ]
    },
    "important": {
      "type": "component",
      "component": "molecules/text-section",
      "label": "Important Information",
      "props": {
        "heading": "Important Information",
        "body": "This is Not a Therapist: Thoughtful is an AI tool, not a human therapist. It cannot and does not provide medical advice or diagnose conditions.\n\nAlways Consult a Professional: Information or suggestions generated by Thoughtful are for general support purposes only. Always consult a qualified medical or mental health professional for critical decisions."
      },
      "expose": [
        "heading",
        "body"
      ]
    },
    "safety": {
      "type": "component",
      "component": "molecules/text-section",
      "label": "Safety and Emergencies",
      "props": {
        "heading": "Safety and Emergencies",
        "body": "If you are in a crisis or need immediate help, do not rely on Thoughtful.\n\nImmediate Support: If you're in a crisis and need to talk to someone now, please call 1 (855) 629-0554 opt. 2 for immediate crisis support or 911. Support is available 24/7.\n\nBeta Status: This AI product is currently in Beta and may not meet standards safety protocols.\n\nAI Can Make Mistakes: The AI is always learning. Sometimes it gives suggestions that don't seem right. Feel free to ignore them. For anything important, double-check and reach out to a licensed professional."
      },
      "expose": [
        "heading",
        "body"
      ]
    }
