  "variables": {},
  "styles": [],
  "selector": ".summary",
  "description": "What T writes up after a session. A header (the date, the title, a line and how long it took) over sections you can show or hide in the Sections slot: Today’s Topic, The Reframe and The Plan (T can leave one out if it does not fit the session), Suggestions (only for LIWT conversations), and, for higher acuity, Your therapist and Support Resources. Off the record shows a label in the header when the person chose it, in any conversation. T is the version T writes; Provider is the version a provider reads, with their photo in a flat header. The provider’s summary has the post-appointment thoughts flow as states: T’s follow-up prompt in place of the summary, then Your Thoughts loading, then added by you.",
  "items": {
    "header": {
      "type": "component",
      "component": "organisms/header-card",
      "label": "Header",
      "props": {
        "state": "default",
        "overline": "Thurs, Oct 20 at 12:38pm",
        "headline": "Managing Financial Stress",
        "body": "You mentioned feeling anxious at work. We could slow this down together and look at what might help you feel more steady.",
        "duration.text": "10 min"
      },
      "expose": [
        "overline",
        "headline",
        "body"
      ]
    },
    "topic": {
      "type": "component",
      "component": "molecules/text-section",
      "label": "Today’s Topic",
      "props": {
        "heading": "Today’s Topic",
        "body": "You came in feeling overwhelmed by low-grade depression and anxiety primarily driven by the financial uncertainty of your work situation.",
        "show": "on"
      },
      "expose": [
        "heading",
        "body"
      ]
    },
    "reframe": {
      "type": "component",
      "component": "molecules/text-section",
      "label": "The Reframe",
      "props": {
        "heading": "The Reframe",
        "body": "We reframed your challenge of paralyzing anxiety to a matter of reclaiming your power by focusing on what you can control",
        "show": "on"
      },
      "expose": [
        "heading",
        "body"
      ]
    },
    "plan": {
      "type": "component",
      "component": "molecules/text-section",
      "label": "The Plan",
      "props": {
        "heading": "The Plan",
        "body": "Immediate Self-Care: Try meditating today (after this session or at 3 PM) to create a clear moment of peace.\n\nSkill Use: Use the 4-4-6 breathing technique when anxiety spikes to reclaim calm.\n\nRoutine Fix: Introduce a “tech reward” system for your children to ease the stressful bedtime routine and lower your evening tension.",
        "show": "on"
      },
      "expose": [
        "heading",
        "body"
      ]
    },
    "suggestions": {
      "type": "component",
      "component": "patterns/suggestions-section",
      "label": "Suggestions",
      "props": {
        "state": "default",
        "show": "off"
      },
      "expose": [
        "heading",
        "copy"
      ]
    },
    "therapist": {
      "type": "component",
      "component": "patterns/therapist-section",
      "label": "Want to talk to someone?",
      "props": {
        "state": "summary-find",
        "show": "off"
      },
      "expose": [
        "state",
        "heading"
      ]
    },
    "resources": {
      "type": "component",
      "component": "patterns/resources-section",
      "label": "Support Resources",
      "props": {
        "state": "default",
        "show": "off"
      },
      "expose": [
        "heading",
        "copy"
      ]
    },
    "thoughts": {
      "type": "component",
      "component": "molecules/text-section",
      "label": "Your Thoughts",
      "props": {
        "heading": "Your Thoughts",
        "body": "You came in feeling overwhelmed by low-grade depression and anxiety primarily driven by the financial uncertainty of your work situation.",
        "show": "off"
      },
      "expose": [
        "heading",
        "body",
        "tag",
        "loading"
      ]
    },
    "loader": {
      "type": "component",
      "component": "organisms/loading-state",
      "label": "Loading state",
      "props": {
        "state": "default"
      },
      "expose": [
        "msg1",
        "msg2",
        "msg3"
      ]
    }
  },
