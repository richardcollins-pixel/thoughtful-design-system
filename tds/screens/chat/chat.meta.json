  "styles": [],
  "selector": ".chat",
  "description": "A whole chat screen: the header, the thread, and either the composer (with the keyboard up or not) or the end of session card. Recommendations, Typing, Session and Session typing (the timer runs) and End of session are the states in the Figma. Sharing sheet and Sharing sheet, off the record show the session sharing sheet opened from the record icon; Off the record is the chat after you have gone off the record (the icon becomes a person with an x).",
  "items": {
    "header": {
      "type": "component",
      "component": "molecules/chat-header",
      "label": "Header",
      "props": {
        "title": "Leave it here"
      },
      "expose": [
        "title",
        "bar",
        "timer",
        "progress",
        "recap"
      ]
    },
    "thread": {
      "type": "component",
      "component": "organisms/chat-thread",
      "label": "Thread",
      "props": {
        "state": "recommendations"
      },
      "expose": [
        "state"
      ]
    },
    "composer": {
      "type": "component",
      "component": "organisms/chat-composer",
      "label": "Composer",
      "props": {
        "state": "input"
      },
      "expose": [
        "state"
      ]
    },
    "end": {
      "type": "component",
      "component": "organisms/end-of-session-card",
      "label": "End of session card",
      "props": {
        "overline": "Time well spent",
        "headline": "You made steady progress today",
        "primary.label": "Review key takeaways",
        "secondary.label": "Share feedback"
      },
      "expose": [
        "overline",
        "headline",
        "primary.label",
        "secondary.label"
      ]
    },
    "sheet": {
      "type": "component",
      "component": "patterns/session-sharing-sheet",
      "label": "Sharing sheet",
      "props": {
        "state": "off"
      },
      "expose": [
        "state"
      ]
    }
  },
