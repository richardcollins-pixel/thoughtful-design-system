  "selector": ".profile-pages",
  "description": "The pages you reach from Profile: About (Meet Thoughtful, with About and Legal), Support (How can we help, and with the call requested), Share feedback (a big text area, the research checkbox and the keyboard) and What is Thoughtful? (a long read).",
  "items": {
    "hero": {
      "type": "component",
      "component": "organisms/hero-header",
      "label": "Hero",
      "props": {
        "state": "warm"
      },
      "expose": [
        "state",
        "header.title",
        "headline"
      ]
    },
    "g1": {
      "type": "component",
      "component": "organisms/action-group",
      "label": "Group 1",
      "props": {
        "state": "two",
        "title": "Group"
      },
      "expose": [
        "state",
        "title"
      ]
    },
    "g2": {
      "type": "component",
      "component": "organisms/action-group",
      "label": "Group 2",
      "props": {
        "state": "two",
        "title": "Group"
      },
      "expose": [
        "state",
        "title"
      ]
    },
    "header": {
