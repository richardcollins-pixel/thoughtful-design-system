      "template": "<section class=\"profile-pages\" data-kind=\"about\"><div class=\"glow profile-pages__glow\" data-theme=\"cool\" data-placement=\"bottom\" aria-hidden=\"true\"><canvas></canvas></div><div class=\"profile-pages__hero\" data-slot=\"hero\">{{item:hero}}</div><div class=\"profile-pages__sections\" data-slot=\"sections\">{{item:g1}}{{item:g2}}</div></section>",
