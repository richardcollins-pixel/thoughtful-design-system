      "component": "molecules/header",
      "label": "Header",
      "props": {
        "variant": "sub-section",
        "title": "Title"
      },
      "expose": [
        "variant",
        "title"
      ]
    },
    "field": {
      "type": "component",
      "component": "atoms/textarea",
      "label": "Feedback field",
      "props": {
        "text": "This is what the user typed",
        "filled": "yes"
      },
      "expose": [
        "text",
        "filled"
      ]
    },
    "check": {
      "type": "component",
