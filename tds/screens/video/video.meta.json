{
  "name": "Video",
  "tier": "screens",
  "category": "screens",
  "stateful": false,
  "uses": [
    "device/status-bar",
    "molecules/avatar-text",
    "molecules/video-tile",
    "atoms/icon-button"
  ],
  "figma": "https://www.figma.com/design/n0xLsDhR2Fim2d6ShDMHQw/In-App-Video-Appointments?node-id=0-1",
  "align": "top",
  "states": [
    {
      "id": "call",
      "name": "In the call",
      "template": "<section class=\"video\"><div class=\"video__backdrop\" data-slot=\"backdrop\">{{item:backdrop}}</div><div class=\"video__top\" data-slot=\"top\">{{item:status}}<div class=\"video__bar\" data-slot=\"controls\"><span class=\"video__bar-left\">{{item:micTop}}{{item:camTop}}</span>{{item:leave}}</div></div><div class=\"video__remote\" data-slot=\"remote\">{{item:remote}}</div><div class=\"video__self\" data-slot=\"self\">{{item:selfView}}</div><div class=\"video__notes\" data-slot=\"notes\">{{item:notes}}</div></section>",
      "slots": [
        {
          "id": "backdrop",
          "label": "Backdrop slot",
          "items": [
            "backdrop"
          ]
        },
        {
          "id": "top",
          "label": "Top slot",
          "items": [
            "status"
          ]
        },
        {
          "id": "controls",
          "label": "Controls slot",
          "items": [
            "leave",
            "micTop",
            "camTop"
          ]
        },
        {
          "id": "remote",
          "label": "Therapist video slot",
          "items": [
            "remote"
          ]
        },
        {
          "id": "self",
          "label": "Your video slot",
          "items": [
            "selfView"
          ]
        },
        {
          "id": "notes",
          "label": "Notes slot",
          "items": [
            "notes"
          ]
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {}
    },
    {
      "id": "call-waiting",
      "name": "Therapist not here yet",
      "template": "<section class=\"video\"><div class=\"video__backdrop\" data-slot=\"backdrop\">{{item:backdrop}}</div><div class=\"video__top\" data-slot=\"top\">{{item:status}}<div class=\"video__bar\" data-slot=\"controls\"><span class=\"video__bar-left\">{{item:micTop}}{{item:camTop}}</span>{{item:leave}}</div></div><div class=\"video__remote\" data-slot=\"remote\">{{item:remote}}</div><div class=\"video__self\" data-slot=\"self\">{{item:selfView}}</div><div class=\"video__notes\" data-slot=\"notes\">{{item:notes}}</div></section>",
      "slots": [
        {
          "id": "backdrop",
          "label": "Backdrop slot",
          "items": [
            "backdrop"
          ]
        },
        {
          "id": "top",
          "label": "Top slot",
          "items": [
            "status"
          ]
        },
        {
          "id": "controls",
          "label": "Controls slot",
          "items": [
            "leave",
            "micTop",
            "camTop"
          ]
        },
        {
          "id": "remote",
          "label": "Therapist video slot",
          "items": [
            "remote"
          ]
        },
        {
          "id": "self",
          "label": "Your video slot",
          "items": [
            "selfView"
          ]
        },
        {
          "id": "notes",
          "label": "Notes slot",
          "items": [
            "notes"
          ]
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {
        "remote": {
          "props": {
            "kind": "waiting",
            "body": "Hang tight!\nKristina will join shortly..."
          }
        },
        "backdrop": {
          "props": {
            "kind": "empty"
          }
        }
      }
    },
    {
      "id": "call-paused",
      "name": "Video paused",
      "template": "<section class=\"video\"><div class=\"video__backdrop\" data-slot=\"backdrop\">{{item:backdrop}}</div><div class=\"video__top\" data-slot=\"top\">{{item:status}}<div class=\"video__bar\" data-slot=\"controls\"><span class=\"video__bar-left\">{{item:micTop}}{{item:camTop}}</span>{{item:leave}}</div></div><div class=\"video__remote\" data-slot=\"remote\">{{item:remote}}</div><div class=\"video__self\" data-slot=\"self\">{{item:selfView}}</div><div class=\"video__notes\" data-slot=\"notes\">{{item:notes}}</div></section>",
      "slots": [
        {
          "id": "backdrop",
          "label": "Backdrop slot",
          "items": [
            "backdrop"
          ]
        },
        {
          "id": "top",
          "label": "Top slot",
          "items": [
            "status"
          ]
        },
        {
          "id": "controls",
          "label": "Controls slot",
          "items": [
            "leave",
            "micTop",
            "camTop"
          ]
        },
        {
          "id": "remote",
          "label": "Therapist video slot",
          "items": [
            "remote"
          ]
        },
        {
          "id": "self",
          "label": "Your video slot",
          "items": [
            "selfView"
          ]
        },
        {
          "id": "notes",
          "label": "Notes slot",
          "items": [
            "notes"
          ]
        }
      ],
      "personas": [
        "provider"
      ],
      "overrides": {
        "remote": {
          "props": {
            "kind": "paused",
            "title": "Video paused",
            "body": "Stay on the call - I’ll fix the video once you have better signal"
          }
        },
        "camTop": {
          "props": {
            "icon": "video-off"
          }
        },
        "selfView": {
          "props": {
            "kind": "empty"
          }
        },
        "backdrop": {
          "props": {
            "kind": "empty"
          }
        }
      }
    }
  ],
  "variables": {},
  "styles": [],
  "selector": ".video",
  "description": "Being in an in-app video appointment (full blend): the therapist’s video as a square across the screen with a blurred, see-through copy of it filling the background, your own video small in the corner, mute and camera on the top left, leave on the top right, and T taking notes at the bottom. Also the therapist not here yet, and video paused.",
  "items": {
    "backdrop": {
      "type": "component",
      "component": "molecules/video-tile",
      "label": "Backdrop video",
      "props": {
        "kind": "video",
        "size": "backdrop",
        "source": "provider"
      },
      "expose": [
        "kind"
      ]
    },
    "status": {
      "type": "component",
      "component": "device/status-bar",
      "label": "Status bar",
      "props": {},
      "expose": []
    },
    "leave": {
      "type": "component",
      "component": "atoms/icon-button",
      "label": "Leave",
      "props": {
        "icon": "x",
        "elevation": "20",
        "size": "md"
      },
      "expose": [
        "icon"
      ]
    },
    "micTop": {
      "type": "component",
      "component": "atoms/icon-button",
      "label": "Microphone",
      "props": {
        "icon": "mic-on",
        "elevation": "20",
        "size": "md"
      },
      "expose": [
        "icon",
        "tone"
      ]
    },
    "camTop": {
      "type": "component",
      "component": "atoms/icon-button",
      "label": "Camera",
      "props": {
        "icon": "video-on",
        "elevation": "20",
        "size": "md"
      },
      "expose": [
        "icon",
        "tone"
      ]
    },
    "remote": {
      "type": "component",
      "component": "molecules/video-tile",
      "label": "Therapist video",
      "props": {
        "kind": "video",
        "size": "remote",
        "source": "provider"
      },
      "expose": [
        "kind",
        "title",
        "body",
        "person"
      ]
    },
    "selfView": {
      "type": "component",
      "component": "molecules/video-tile",
      "label": "Your video",
      "props": {
        "kind": "video",
        "size": "self",
        "source": "user"
      },
      "expose": [
        "kind"
      ]
    },
    "notes": {
      "type": "component",
      "component": "molecules/avatar-text",
      "label": "T is taking notes",
      "props": {
        "avatar": "t",
        "size": "28",
        "style": "small",
        "title": "T is taking notes"
      },
      "expose": [
        "title"
      ]
    }
  },
  "personas": [
    "provider"
  ],
  "inputs": [],
  "properties": [],
  "prompts": []
}