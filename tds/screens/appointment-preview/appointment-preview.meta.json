        "size": "preview",
        "source": "user"
      },
      "expose": [
        "kind",
        "title",
        "body",
        "person"
      ]
    },
    "mic": {
      "type": "component",
      "component": "atoms/icon-button",
      "label": "Microphone",
      "props": {
