    "person": {
      "type": "person",
      "label": "Name",
      "default": "kristina"
    }
  },
  "template": "<img class=\"photo\" src=\"../tds/assets/{{person.photo}}\" alt=\"{{person.name}}\">",
  "skeleton": "<span class=\"photo\" data-state=\"loading\"></span>"
