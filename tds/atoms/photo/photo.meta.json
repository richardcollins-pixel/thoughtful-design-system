{
  "name": "Photo",
  "tier": "atoms",
  "category": "media",
  "stateful": false,
  "uses": [],
  "markup": "<img class=\"photo\" src=\"../tds/assets/images/therapists/Therapist-7.png\" alt=\"\" style=\"max-width:20em\">",
  "attributes": {},
  "states": [
    "loading"
  ],
