    "current": {
      "type": "enum",
      "label": "Step",
      "ui": "steps",
      "values": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ],
      "default": "1"
    }
  },
  "template": "<span class=\"dots\" data-current=\"{{current}}\" role=\"img\" aria-label=\"Step {{current}} of 6\"><i></i><i></i><i></i><i></i><i></i><i></i></span>"
