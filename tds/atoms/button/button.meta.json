{
  "name": "Button",
  "tier": "atoms",
  "category": "actions",
  "stateful": false,
  "uses": [],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=19-366",
  "markup": "<button class=\"button\" data-variant=\"filled\">Button</button>",
  "attributes": {
    "data-variant": { "type": "enum", "values": ["filled", "outline", "glass", "flat"], "default": "filled" },
    "data-size": { "type": "enum", "values": ["lg", "md", "sm"], "default": "md" },
    "data-on": { "type": "enum", "values": ["true", "false"], "default": "true", "when": { "data-variant": "outline" } },
    "data-width": { "type": "enum", "values": ["hug", "full"], "default": "hug" }
  },
  "states": ["hover", "pressed", "focus", "disabled", "loading", "confirmation"],
  "variables": {
    "--button-fill": "color",
    "--button-text": "color",
    "--button-border": "color",
    "--button-radius": "radius",
    "--button-height": "padding",
    "--button-padding-x": "padding",
    "--button-gap": "padding",
    "--button-scale-pressed": "number"
  },
  "styles": ["motion-state", "motion-press"]
}
