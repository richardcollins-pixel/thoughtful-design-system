{
  "name": "Blob",
  "tier": "atoms",
  "category": "media",
  "stateful": false,
  "uses": [],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=4359-55294",
  "markup": "<div class=\"blob\" data-shape=\"blob\" data-theme=\"cool\" data-cycle=\"on\" data-size=\"124\"><canvas aria-hidden=\"true\"></canvas></div>",
  "attributes": {
    "data-shape": {
      "type": "enum",
      "values": [
        "blob",
        "pencil",
        "bubble",
        "envelope",
        "chat"
      ],
      "default": "blob"
    },
    "data-theme": {
      "type": "enum",
      "values": [
        "cool",
        "warm",
        "rose",
        "ember",
        "bloom"
      ],
      "default": "cool"
    },
    "data-cycle": {
      "type": "enum",
      "values": [
        "on",
        "off"
      ],
      "default": "on"
    },
    "data-loop": {
      "type": "enum",
      "values": [
        "off",
        "pencil",
        "envelope",
        "bubble",
        "chat"
      ],
      "default": "off"
    },
    "data-size": {
      "type": "enum",
      "values": [
        "24",
        "32",
        "48",
        "80",
        "124",
        "180"
      ],
      "default": "124"
    }
  },
  "states": [],
  "variables": {
    "--blob-size": "padding"
  },
  "styles": [],
  "description": "The animated shape that is T. It bounces slowly up and down, its outline morphs slowly, and its colors travel round the edge while the theme shifts every few seconds (cool, warm, rose). In special cases it becomes another shape to stand for what T is doing (a pencil, a chat bubble, an email); the plain blob is its default, and it morphs back.",
  "props": {
    "shape": {
      "type": "enum",
      "label": "Shape",
      "values": [
        "blob",
        "pencil",
        "bubble",
        "envelope",
        "chat"
      ],
      "default": "blob"
    },
    "theme": {
      "type": "enum",
      "label": "Theme",
      "values": [
        "cool",
        "warm",
        "rose",
        "ember",
        "bloom"
      ],
      "default": "cool"
    },
    "cycle": {
      "type": "enum",
      "label": "Color cycle",
      "ui": "steps",
      "values": [
        "on",
        "off"
      ],
      "default": "on"
    },
    "loop": {
      "type": "enum",
      "label": "Loop",
      "values": [
        "off",
        "pencil",
        "envelope",
        "bubble",
        "chat"
      ],
      "default": "off"
    },
    "size": {
      "type": "enum",
      "label": "Size",
      "values": [
        "24",
        "32",
        "48",
        "80",
        "124",
        "180"
      ],
      "default": "124"
    }
  },
  "template": "<div class=\"blob\" data-shape=\"{{shape}}\" data-theme=\"{{theme}}\" data-cycle=\"{{cycle}}\" data-loop=\"{{loop}}\" data-size=\"{{size}}\"><canvas aria-hidden=\"true\"></canvas></div>",
  "skeleton": "<span class=\"skeleton\" data-shape=\"dot\" style=\"width:124px;height:124px\"></span>",
  "gallery": "examples",
  "examples": [
    {
      "name": "",
      "markup": "<div class=\"tile hero\" data-clip data-glow=\"center\"><div class=\"glow\" data-for=\"hero-blob\" data-placement=\"behind\" style=\"--glow-size:430px\"><canvas aria-hidden=\"true\"></canvas></div><div class=\"glow\" data-theme=\"cool\" data-placement=\"bottom\" style=\"--glow-size:430px\"><canvas aria-hidden=\"true\"></canvas></div><div class=\"blob\" id=\"hero-blob\" data-size=\"180\" data-theme=\"cool\" data-cycle=\"on\"><canvas aria-hidden=\"true\"></canvas></div><div data-controls style=\"position:relative;z-index:1\"></div></div>",
      "target": ".blob",
      "controls": [
        {
          "type": "switch",
          "label": "Color cycle",
          "attr": "data-cycle",
          "on": "on",
          "off": "off"
        },
        {
          "type": "radio",
          "label": "Starts on",
          "attr": "data-theme",
          "values": [
            "cool",
            "warm",
            "rose"
          ]
        },
        {
          "type": "radio",
          "label": "Glow",
          "attr": "data-glow",
          "target": ".hero",
          "col": 2,
          "values": [
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            },
            {
              "value": "none",
              "label": "None"
            }
          ]
        }
      ]
    },
    {
      "name": "sizes",
      "markup": "<div class=\"tiles\"><div class=\"tile\" data-clip><div class=\"stage\"><div class=\"blob\" data-size=\"24\" data-theme=\"warm\"><canvas aria-hidden=\"true\"></canvas></div></div><p class=\"cap\">24px</p></div><div class=\"tile\" data-clip><div class=\"stage\"><div class=\"blob\" data-size=\"32\" data-theme=\"warm\"><canvas aria-hidden=\"true\"></canvas></div></div><p class=\"cap\">32px</p></div><div class=\"tile\" data-clip><div class=\"stage\"><div class=\"blob\" data-size=\"48\" data-theme=\"warm\"><canvas aria-hidden=\"true\"></canvas></div></div><p class=\"cap\">48px</p></div><div class=\"tile\" data-clip><div class=\"stage\"><div class=\"blob\" data-size=\"80\" data-theme=\"warm\"><canvas aria-hidden=\"true\"></canvas></div></div><p class=\"cap\">80px</p></div><div class=\"tile\" data-clip><div class=\"stage\"><div class=\"blob\" data-size=\"124\" data-theme=\"warm\"><canvas aria-hidden=\"true\"></canvas></div></div><p class=\"cap\">124px</p></div><div class=\"tile\" data-clip><div class=\"stage\"><div class=\"blob\" data-size=\"180\" data-theme=\"warm\"><canvas aria-hidden=\"true\"></canvas></div></div><p class=\"cap\">180px</p></div></div>"
    },
    {
      "name": "morph",
      "markup": "<div class=\"tiles\"><div class=\"tile\" data-clip><div class=\"stage\"><div class=\"blob\" data-size=\"124\" data-loop=\"pencil\" data-loop-delay=\"0\"><canvas aria-hidden=\"true\"></canvas></div></div><p class=\"cap\">Pencil</p></div><div class=\"tile\" data-clip><div class=\"stage\"><div class=\"blob\" data-size=\"124\" data-loop=\"envelope\" data-loop-delay=\"2500\"><canvas aria-hidden=\"true\"></canvas></div></div><p class=\"cap\">Email</p></div><div class=\"tile\" data-clip><div class=\"stage\"><div class=\"blob\" data-size=\"124\" data-loop=\"chat\" data-loop-delay=\"5000\"><canvas aria-hidden=\"true\"></canvas></div></div><p class=\"cap\">Chat bubble</p></div></div>"
    }
  ]
}
