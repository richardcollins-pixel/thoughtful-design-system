{
  "name": "Alert",
  "tier": "device",
  "category": "device",
  "stateful": false,
  "uses": [],
  "figma": "https://www.figma.com/design/pdq8KcTCIJAtXwcgReiwlC/Thoughtful-Design-System?node-id=3953-56958",
  "attributes": {},
  "states": [],
  "variables": {},
  "styles": [],
  "description": "The iPhone’s own alert (here the tracking permission): a dark glass card with the app’s icon, a bold title, a message and two pill buttons. It belongs to the phone, not the app, so Device UI off hides it. The icon can be the app, the microphone or the camera (an orange tile with the permission badge) or none; the two buttons stack or sit side by side (the permission prompts).",
  "content": [
    {
      "label": "Title",
      "selector": ".device-alert__title"
    },
    {
      "label": "Message",
      "selector": ".device-alert__message"
    }
  ],
  "props": {
    "title": {
      "type": "text",
      "label": "Title",
      "default": "Allow “Thoughtful” to track your activity across other companies’ apps and websites?"
    },
    "message": {
      "type": "text",
      "label": "Message",
      "default": "This helps “Thoughtful” recognize and link your account correctly, so your experience works as expected."
    },
    "primary": {
      "type": "text",
      "label": "First button",
      "default": "Ask App Not to Track"
    },
    "secondary": {
      "type": "text",
      "label": "Second button",
      "default": "Allow"
    },
    "icon": {
      "type": "enum",
      "label": "Icon",
      "ui": "steps",
      "values": [
        "app",
        "mic",
        "camera",
        "none"
      ],
      "default": "app"
    },
    "buttons": {
      "type": "enum",
      "label": "Buttons",
      "ui": "steps",
      "values": [
        "stacked",
        "row"
      ],
      "default": "stacked"
    }
  },
  "template": "<div class=\"device-alert\" data-icon=\"{{icon}}\" data-buttons=\"{{buttons}}\" role=\"alertdialog\"><div class=\"device-alert__icon\"><span class=\"device-alert__app\"><img src=\"../tds/assets/images/system/app-icon.png\" alt=\"\"></span><span class=\"device-alert__tile\"><i class=\"icon icon-mic-on\"></i><i class=\"icon icon-video-chat\"></i></span><span class=\"device-alert__badge\"><img src=\"../tds/assets/images/system/att-icon.png\" alt=\"\"></span></div><div class=\"device-alert__text\"><p class=\"device-alert__title\">{{title}}</p><p class=\"device-alert__message\">{{message}}</p></div><div class=\"device-alert__buttons\"><button class=\"device-alert__button\">{{primary}}</button><button class=\"device-alert__button\">{{secondary}}</button></div></div>",
  "markup": "<div class=\"device-alert\" data-icon=\"app\" data-buttons=\"stacked\" role=\"alertdialog\"><div class=\"device-alert__icon\"><span class=\"device-alert__app\"><img src=\"../tds/assets/images/system/app-icon.png\" alt=\"\"></span><span class=\"device-alert__tile\"><i class=\"icon icon-mic-on\"></i><i class=\"icon icon-video-chat\"></i></span><span class=\"device-alert__badge\"><img src=\"../tds/assets/images/system/att-icon.png\" alt=\"\"></span></div><div class=\"device-alert__text\"><p class=\"device-alert__title\">Title</p><p class=\"device-alert__message\">Message</p></div><div class=\"device-alert__buttons\"><button class=\"device-alert__button\">OK</button><button class=\"device-alert__button\">Cancel</button></div></div>"
}